            <h3>Organização financeira</h3>

            <div class="report-row">
              <span>Contas registradas</span>
              <strong data-report="financial.accounts">—</strong>
            </div>

            <div class="report-row">
              <span>Dinheiro protegido</span>
              <strong data-report-money="financial.protectedMoney">—</strong>
            </div>

            <div class="report-row">
              <span>Missões diárias</span>
              <strong data-report="financial.dailyMissions">—</strong>
            </div>
          </article>

        </div>
      </section>

      <section class="reports-group">
        <div class="reports-group-header">
          <div>
            <h2>🎯 Missões</h2>
            <p>Atividades registradas no período.</p>
          </div>
        </div>

        <div class="reports-grid reports-grid-small">

          <article class="report-card">
            <span class="report-card-icon">📋</span>
            <span class="report-card-label">Total</span>
            <strong data-report="missions.total">—</strong>
          </article>

          <article class="report-card">
            <span class="report-card-icon">✅</span>
            <span class="report-card-label">Concluídas</span>
            <strong data-report="missions.completed">—</strong>
          </article>

          <article class="report-card">
            <span class="report-card-icon">🛡️</span>
            <span class="report-card-label">Não apostou</span>
            <strong data-report="missions.noBet">—</strong>
          </article>

          <article class="report-card">
            <span class="report-card-icon">💭</span>
            <span class="report-card-label">Teve vontade</span>
            <strong data-report="missions.hadUrge">—</strong>
          </article>

          <article class="report-card">
            <span class="report-card-icon">💰</span>
            <span class="report-card-label">Valor protegido</span>
            <strong data-report-money="missions.protectedValue">—</strong>
          </article>

        </div>
      </section>

      <section class="reports-group">
        <div class="reports-group-header">
          <div>
            <h2>📝 Atividade</h2>
            <p>Registros operacionais gerados pelo sistema.</p>
          </div>
        </div>

        <div class="reports-detail-grid">

          <article class="report-panel">
            <div class="report-row">
              <span>Logs de auditoria</span>
              <strong data-report="activity.auditLogs">—</strong>
            </div>

            <div class="report-row">
              <span>Notificações</span>
              <strong data-report="activity.notifications">—</strong>
            </div>

            <div class="report-row">
              <span>Atualizações</span>
              <strong data-report="activity.updates">—</strong>
            </div>
          </article>

        </div>
      </section>

      <div class="reports-footer">
        <span id="reports-generated-at">
          Relatório ainda não carregado.
        </span>
      </div>

    </div>
  </section>
</div>





      <div id="page-logs" class="page">
  <section class="admin-section logs-page">

    <div class="logs-header">
      <div>
        <h2>📝 Logs de Auditoria</h2>
        <p>
          Histórico das ações realizadas no sistema administrativo.
        </p>
      </div>

      <div class="logs-header-actions">
        <span id="logs-total" class="logs-total">
          0 registros
        </span>

        <button
          type="button"
          id="logs-refresh-btn"
          class="admin-btn"
        >
          ↻ Atualizar
        </button>
      </div>
    </div>

    <div class="admin-card logs-filters-card">

      <div class="card-header">
        <div>
          <h3>Filtros</h3>
          <p>
            Encontre rapidamente uma ação ou ocorrência específica.
          </p>
        </div>
      </div>

      <div class="logs-toolbar">

        <label class="logs-field">
          <span>Período</span>
          <select id="logs-period">
            <option value="today">Hoje</option>
            <option value="7d">Últimos 7 dias</option>
            <option value="30d" selected>Últimos 30 dias</option>
            <option value="90d">Últimos 90 dias</option>
            <option value="all">Tudo</option>
          </select>
        </label>

        <label class="logs-field">
          <span>Ação</span>
          <select id="logs-action">
            <option value="">Todas as ações</option>
          </select>
        </label>

        <label class="logs-field">
          <span>Entidade</span>
          <select id="logs-entity">
            <option value="">Todas as entidades</option>
          </select>
        </label>

        <label class="logs-field logs-search-field">
          <span>Buscar</span>
          <input
            type="search"
            id="logs-search"
            placeholder="Ação, usuário, entidade ou detalhe..."
            autocomplete="off"
          />
        </label>

        <button
          type="button"
          id="logs-clear-filters"
          class="admin-btn"
        >
          Limpar
        </button>

      </div>
    </div>

    <div
      id="logs-status"
      class="logs-status"
      role="status"
      aria-live="polite"
    >
      Aguardando carregamento...
    </div>

    <div class="admin-card logs-table-card">

      <div class="card-header">
        <div>
          <h3>Registros</h3>
          <p>
            Os registros mais recentes aparecem primeiro.
          </p>
        </div>
      </div>

      <div class="logs-table-wrap">
        <table class="logs-table">
          <thead>
            <tr>
              <th>Data/Hora</th>
              <th>Ação</th>
              <th>Entidade</th>
              <th>ID da entidade</th>
              <th>Usuário</th>
              <th>Responsável</th>
              <th>Detalhes</th>
            </tr>
          </thead>

          <tbody id="logs-table-body">
            <tr>
              <td colspan="7" class="logs-empty">
                Carregando logs...
              </td>
            </tr>
          </tbody>
        </table>
      </div>

      <div class="logs-pagination">

        <button
          type="button"
          id="logs-prev"
          class="admin-btn"
          disabled
        >
          ← Anterior
        </button>

        <span id="logs-page-info">
          Página 1 de 1
        </span>

        <button
          type="button"
          id="logs-next"
          class="admin-btn"
          disabled
        >
          Próxima →
        </button>

      </div>
    </div>

    <div
      id="logs-detail"
      class="admin-card logs-detail-card"
      hidden
    >
      <div class="card-header">
        <div>
          <h3>Detalhes do registro</h3>
          <p>
            Informações completas do evento selecionado.
          </p>
        </div>

        <button
          type="button"
          id="logs-detail-close"
          class="admin-btn"
        >
          Fechar
        </button>
      </div>

      <pre id="logs-detail-content"></pre>
    </div>

  </section>
</div>


