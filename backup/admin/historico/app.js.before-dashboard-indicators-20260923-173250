async function loadDashboard() {

  try {

    const [
      dashboardData,
      services,
      specialists,
      security
    ] = await Promise.all([
      api("/api/admin/dashboard"),
      api("/api/admin/services"),
      api("/api/admin/specialists"),
      api("/api/admin/security/events?limit=20")
    ]);

    dashboard = dashboardData;

    updateDashboardAlerts(dashboardData);

    renderMetrics(
      dashboardData
    );

    renderServices(
      services.services || []
    );

    renderSpecialists(
      specialists.specialists || []
    );

    renderSecurityAlerts(
      security.events || []
    );

    renderActivity(
      dashboardData
    );

    renderProtection(
      dashboardData.dashboard || {}
    );

    await loadDashboardCommandCenter();
    startDashboardAutoRefresh();

    document.getElementById(
      "lastUpdate"
    ).textContent =
      `Atualizado às ${new Date().toLocaleTimeString("pt-BR")}`;

  } catch (error) {

    console.error(error);

    showToast(
      `Erro no dashboard: ${error.message}`,
      "error"
    );
  }
}



