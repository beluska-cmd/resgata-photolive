  async function loadReports(period = reportsPeriod) {

    if (reportsLoading) {
      return;
    }

    reportsLoading = true;
    reportsPeriod = period;

    updateReportsPeriodButtons();
    setReportsState("loading");

    try {

      const authToken =
        reportsToken();

      if (!authToken) {
        throw new Error(
          "Sessão administrativa não encontrada."
        );
      }

      const response =
        await fetch(
          `/api/admin/reports?period=${encodeURIComponent(reportsPeriod)}`,
          {
            method: "GET",
            headers: {
              Authorization:
                `Bearer ${authToken}`,
              Accept:
                "application/json"
            }
          }
        );

      const data =
        await response.json();

      if (!response.ok) {
        throw new Error(
          data?.message ||
          data?.error ||
          `HTTP ${response.status}`
        );
      }

      renderReports(data);

    } catch (error) {

      console.error(
        "ERRO AO CARREGAR RELATÓRIOS:",
        error
      );

      setReportsState("error");

    } finally {

      reportsLoading = false;

    }
  }

  function bindReportsEvents() {

    const elements =
      reportsElements();

    if (!elements.page) {
      return;
    }

    elements.periodButtons.forEach(button => {

      button.addEventListener(
        "click",
        () => {

          const period =
            button.dataset.period;

          if (!period) {
            return;
          }

          loadReports(period);

        }
      );

    });

    if (elements.refresh) {

      elements.refresh.addEventListener(
        "click",
        () => {
          loadReports(reportsPeriod);
        }
      );

    }

  }

  /*
   * Quando a página de relatórios for aberta,
   * carrega os dados reais.
   */

  const originalOpenPage =
    window.openPage;

  if (typeof originalOpenPage === "function") {

    window.openPage =
      async function(page, ...args) {

        const result =
          await originalOpenPage.apply(
            this,
            [page, ...args]
          );

        if (page === "reports") {
          await loadReports(reportsPeriod);
        }

        return result;
      };

  }

  /*
   * Inicialização.
   */

  if (
    document.readyState === "loading"
  ) {

    document.addEventListener(
      "DOMContentLoaded",
      bindReportsEvents,
      { once: true }
    );

  } else {

    bindReportsEvents();

  }

  /*
   * Disponibiliza para o restante do Admin.
   */

  window.loadAdminReports =
    loadReports;

})();

/* ==========================================================
   RESGATA+ — LOGS DE AUDITORIA
   ========================================================== */

(function logsModule() {
  "use strict";

  let logsPeriod = "30d";
  let logsAction = "";
  let logsEntity = "";
  let logsSearch = "";
  let logsPage = 1;
  const logsLimit = 50;
  let logsPages = 1;
  let logsLoading = false;

  function getLogsToken() {
    if (typeof token === "function") {
      const currentToken = token();
      if (currentToken) {
        return currentToken;
      }
    }

    return (
      localStorage.getItem("resgata_admin_token") ||
      sessionStorage.getItem("resgata_admin_token") ||
      localStorage.getItem("adminToken") ||
      sessionStorage.getItem("adminToken") ||
      ""
    );
  }

  function escapeHtml(value) {
    return String(value ?? "")
      .replace(/&/g, "&amp;")
      .replace(/</g, "&lt;")
      .replace(/>/g, "&gt;")
      .replace(/"/g, "&quot;")
      .replace(/'/g, "&#039;");
  }

  function formatDate(value) {
    if (!value) return "—";

    const raw = String(value);

    let date;

    if (/^\d+$/.test(raw)) {
      const number = Number(raw);

      date = new Date(
        number < 100000000000
          ? number * 1000
          : number
      );
    } else {
      date = new Date(raw);
    }

    if (Number.isNaN(date.getTime())) {
      return raw;
    }

    return new Intl.DateTimeFormat("pt-BR", {
      dateStyle: "short",
      timeStyle: "medium"
    }).format(date);
  }

  function formatDetails(value) {
    if (!value) {
      return "—";
    }

    try {
      const parsed =
        typeof value === "string"
          ? JSON.parse(value)
          : value;

      return JSON.stringify(parsed, null, 2);
    } catch {
      return String(value);
    }
  }

  function setLogsStatus(message, type = "") {
    const element =
      document.getElementById("logs-status");

    if (!element) return;

    element.textContent = message;
    element.dataset.status = type;
  }

  function setLogsLoading(loading) {
    logsLoading = loading;

    const refresh =
      document.getElementById("logs-refresh-btn");

    if (refresh) {
      refresh.disabled = loading;
      refresh.textContent =
        loading
          ? "⟳ Carregando..."
          : "↻ Atualizar";
    }
  }

  function updatePagination() {
    const info =
      document.getElementById("logs-page-info");

    const prev =
      document.getElementById("logs-prev");

    const next =
      document.getElementById("logs-next");

    if (info) {
      info.textContent =
        `Página ${logsPage} de ${logsPages}`;
    }

    if (prev) {
      prev.disabled =
        logsLoading || logsPage <= 1;
    }

    if (next) {
      next.disabled =
        logsLoading || logsPage >= logsPages;
    }
  }

  function updateTotal(total) {
    const element =
      document.getElementById("logs-total");

    if (!element) return;

    element.textContent =
      `${Number(total || 0).toLocaleString("pt-BR")} registros`;
  }

  function renderLogs(logs) {
    const tbody =
      document.getElementById("logs-table-body");

    if (!tbody) return;

    if (!Array.isArray(logs) || logs.length === 0) {
      tbody.innerHTML = `
        <tr>
          <td colspan="7" class="logs-empty">
            Nenhum registro encontrado.
          </td>
        </tr>
      `;

      return;
    }

    tbody.innerHTML = logs.map((log) => {
      const details =
        formatDetails(log.details);

      const compactDetails =
        details.length > 180
          ? `${details.slice(0, 180)}...`
          : details;

      return `
        <tr>
          <td>
            ${escapeHtml(formatDate(log.created_at))}
          </td>

          <td>
            <span class="logs-action">
              ${escapeHtml(log.action || "—")}
            </span>
          </td>

          <td>
            ${escapeHtml(log.entity || "—")}
          </td>

          <td>
            ${escapeHtml(log.entity_id || "—")}
          </td>

          <td>
            ${escapeHtml(log.user_id || "—")}
          </td>

          <td>
            ${
              log.adminName
                ? `${escapeHtml(log.adminName)}${
                    log.adminEmail
                      ? `<br><small>${escapeHtml(log.adminEmail)}</small>`
                      : ""
                  }`
                : "—"
            }
          </td>

          <td>
            <button
              type="button"
              class="admin-btn logs-detail-button"
              data-log-id="${escapeHtml(log.id)}"
            >
              Ver detalhes
            </button>

            <div
              hidden
              data-log-details="${escapeHtml(log.id)}"
            >${escapeHtml(compactDetails)}</div>
          </td>
        </tr>
      `;
    }).join("");

    tbody
      .querySelectorAll(".logs-detail-button")
      .forEach((button) => {
        button.addEventListener("click", () => {
          const id =
            button.dataset.logId;

          const log =
            logs.find(
              item =>
                String(item.id) === String(id)
            );

          if (log) {
            showLogDetails(log);
          }
        });
      });
  }

  function showLogDetails(log) {
    const panel =
      document.getElementById("logs-detail");

    const content =
      document.getElementById("logs-detail-content");

    if (!panel || !content) return;

    const detail = {
      id: log.id,
      data_hora: formatDate(log.created_at),
      usuario: log.user_id || null,
      acao: log.action || null,
      entidade: log.entity || null,
      entidade_id: log.entity_id || null,
      detalhes:
        formatDetails(log.details)
    };

    content.textContent =
      JSON.stringify(detail, null, 2);

    panel.hidden = false;

    panel.scrollIntoView({
      behavior: "smooth",
      block: "start"
    });
  }

  function closeLogDetails() {
    const panel =
      document.getElementById("logs-detail");

    if (panel) {
      panel.hidden = true;
    }
  }

  function populateFilterOptions(logs) {
    const actionSelect =
      document.getElementById("logs-action");

    const entitySelect =
      document.getElementById("logs-entity");

    if (!Array.isArray(logs)) return;

    const actions = [
      ...new Set(
        logs
          .map(log => log.action)
          .filter(Boolean)
      )
    ].sort();

    const entities = [
      ...new Set(
        logs
          .map(log => log.entity)
          .filter(Boolean)
      )
    ].sort();

    if (actionSelect) {
      const current = logsAction;

      actionSelect.innerHTML =
        `<option value="">Todas as ações</option>` +
        actions
          .map(
            value =>
              `<option value="${escapeHtml(value)}">${escapeHtml(value)}</option>`
          )
          .join("");

      actionSelect.value = current;
    }

    if (entitySelect) {
      const current = logsEntity;

      entitySelect.innerHTML =
        `<option value="">Todas as entidades</option>` +
        entities
          .map(
            value =>
              `<option value="${escapeHtml(value)}">${escapeHtml(value)}</option>`
          )
          .join("");

      entitySelect.value = current;
    }
  }

  async function loadLogs(options = {}) {
    if (logsLoading) return;

    if (options.resetPage) {
      logsPage = 1;
    }

    setLogsLoading(true);
    setLogsStatus("Carregando registros...");

    try {
      const token = getLogsToken();

      if (!token) {
        throw new Error(
          "Sessão administrativa não encontrada."
        );
      }

      const params = new URLSearchParams({
        period: logsPeriod,
        action: logsAction,
        entity: logsEntity,
        search: logsSearch,
        page: String(logsPage),
        limit: String(logsLimit)
      });

      const response =
        await fetch(
          `/api/admin/logs?${params.toString()}`,
          {
            method: "GET",
            headers: {
              Authorization:
                `Bearer ${token}`
            }
          }
        );

      const data =
        await response.json();

      if (!response.ok || !data.ok) {
        throw new Error(
          data.error ||
          "Não foi possível carregar os logs."
        );
      }

      logsPages =
        Math.max(
          1,
          Number(data.pages || 1)
        );

      logsPage =
        Math.min(
          Math.max(1, Number(data.page || 1)),
          logsPages
        );

      updateTotal(data.total);
      renderLogs(data.logs || []);
      populateFilterOptions(data.logs || []);
      updatePagination();

      setLogsStatus(
        `${Number(data.total || 0).toLocaleString("pt-BR")} registro(s) encontrado(s).`,
        "success"
      );

    } catch (error) {
      console.error(
        "RESGATA+ LOGS:",
        error
      );

      const tbody =
        document.getElementById(
          "logs-table-body"
        );

      if (tbody) {
        tbody.innerHTML = `
          <tr>
            <td colspan="7" class="logs-empty">
              Não foi possível carregar os logs.
            </td>
          </tr>
        `;
      }

      updateTotal(0);
      updatePagination();

      setLogsStatus(
        error?.message ||
        "Erro ao carregar os logs.",
        "error"
      );

    } finally {
      setLogsLoading(false);
      updatePagination();
    }
  }

  function setupLogsEvents() {
    const period =
      document.getElementById("logs-period");

    const action =
      document.getElementById("logs-action");

    const entity =
      document.getElementById("logs-entity");

    const search =
      document.getElementById("logs-search");

    const refresh =
      document.getElementById("logs-refresh-btn");

    const clear =
      document.getElementById("logs-clear-filters");

    const prev =
      document.getElementById("logs-prev");

    const next =
      document.getElementById("logs-next");

    const close =
      document.getElementById("logs-detail-close");

    if (period) {
      period.addEventListener(
        "change",
        () => {
          logsPeriod = period.value;
          loadLogs({
            resetPage: true
          });
        }
      );
    }

    if (action) {
      action.addEventListener(
        "change",
        () => {
          logsAction = action.value;
          loadLogs({
            resetPage: true
          });
        }
      );
    }

    if (entity) {
      entity.addEventListener(
        "change",
        () => {
          logsEntity = entity.value;
          loadLogs({
            resetPage: true
          });
        }
      );
    }

    if (search) {
      let timer;

      search.addEventListener(
        "input",
        () => {
          clearTimeout(timer);

          timer = setTimeout(() => {
            logsSearch =
              search.value.trim();

            loadLogs({
              resetPage: true
            });
          }, 350);
        }
      );
    }

    if (refresh) {
      refresh.addEventListener(
        "click",
        () => {
          loadLogs();
        }
      );
    }

    if (clear) {
      clear.addEventListener(
        "click",
        () => {
          logsPeriod = "30d";
          logsAction = "";
          logsEntity = "";
          logsSearch = "";
          logsPage = 1;

          if (period) {
            period.value = "30d";
          }

          if (action) {
            action.value = "";
          }

          if (entity) {
            entity.value = "";
          }

          if (search) {
            search.value = "";
          }

          loadLogs({
            resetPage: true
          });
        }
      );
    }

    if (prev) {
      prev.addEventListener(
        "click",
        () => {
          if (
            logsPage <= 1 ||
            logsLoading
          ) {
            return;
          }

          logsPage -= 1;
          loadLogs();
        }
      );
    }

    if (next) {
      next.addEventListener(
        "click",
        () => {
          if (
            logsPage >= logsPages ||
            logsLoading
          ) {
            return;
          }

          logsPage += 1;
          loadLogs();
        }
      );
    }

    if (close) {
      close.addEventListener(
        "click",
        closeLogDetails
      );
    }
  }

  const originalOpenPage =
    window.openPage;

  if (
    typeof originalOpenPage === "function"
  ) {
    window.openPage =
      async function(page, ...args) {
        const result =
          await originalOpenPage.apply(
            this,
            [page, ...args]
          );

        if (page === "logs") {
          await loadLogs();
        }

        return result;
      };
  }

  document.addEventListener(
    "DOMContentLoaded",
    () => {
      setupLogsEvents();
    }
  );

  window.loadAdminLogs = loadLogs;

})();
