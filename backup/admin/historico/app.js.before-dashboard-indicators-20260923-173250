(function reportsModule() {

  let reportsPeriod = "30d";
  let reportsLoading = false;

  function reportsElements() {
    return {
      page: document.getElementById("page-reports"),
      refresh: document.getElementById("reports-refresh"),
      status: document.getElementById("reports-status"),
      loading: document.getElementById("reports-loading"),
      error: document.getElementById("reports-error"),
      generatedAt: document.getElementById("reports-generated-at"),
      periodButtons: Array.from(
        document.querySelectorAll(".reports-period-btn")
      )
    };
  }

  function reportsToken() {
    if (typeof token === "function") {
      return token();
    }

    return (
      localStorage.getItem("admin_token") ||
      localStorage.getItem("resgata_admin_token") ||
      sessionStorage.getItem("admin_token") ||
      ""
    );
  }

  function reportsMoney(value) {
    const number = Number(value || 0);

    return number.toLocaleString("pt-BR", {
      style: "currency",
      currency: "BRL"
    });
  }

  function reportsValue(value) {
    const number = Number(value || 0);

    return number.toLocaleString("pt-BR");
  }

  function reportsGet(object, path) {
    return path
      .split(".")
      .reduce(
        (current, key) =>
          current !== null &&
          current !== undefined
            ? current[key]
            : undefined,
        object
      );
  }

  function setReportValue(path, value) {
    document
      .querySelectorAll(
        `[data-report="${path}"]`
      )
      .forEach(element => {
        element.textContent =
          value === null ||
          value === undefined
            ? "—"
            : reportsValue(value);
      });
  }

  function setReportMoney(path, value) {
    document
      .querySelectorAll(
        `[data-report-money="${path}"]`
      )
      .forEach(element => {
        element.textContent =
          reportsMoney(value);
      });
  }

  function setReportsState(state) {

    const elements =
      reportsElements();

    if (!elements.page) {
      return;
    }

    if (elements.loading) {
      elements.loading.classList.toggle(
        "hidden",
        state !== "loading"
      );
    }

    if (elements.error) {
      elements.error.classList.toggle(
        "hidden",
        state !== "error"
      );
    }

    if (elements.status) {

      if (state === "loading") {
        elements.status.textContent =
          "Carregando...";
      }

      if (state === "error") {
        elements.status.textContent =
          "Erro ao carregar";
      }

      if (state === "ready") {
        elements.status.textContent =
          `Período: ${reportsPeriod}`;
      }
    }

    if (elements.refresh) {
      elements.refresh.disabled =
        state === "loading";

      elements.refresh.textContent =
        state === "loading"
          ? "⏳ Carregando..."
          : "↻ Atualizar";
    }
  }

  function updateReportsPeriodButtons() {

    const elements =
      reportsElements();

    elements.periodButtons.forEach(button => {

      button.classList.toggle(
        "active",
        button.dataset.period === reportsPeriod
      );

    });
  }

  function renderReports(data) {

    if (!data || data.ok !== true) {
      throw new Error(
        data?.message ||
        data?.error ||
        "Relatório inválido."
      );
