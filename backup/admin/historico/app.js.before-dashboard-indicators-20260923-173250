      const haystack = [
        service.name,
        service.description,
        service.category,
        service.id
      ]
        .join(" ")
        .toLowerCase();

      if (search && !haystack.includes(search)) {
        return false;
      }

      if (
        status === "enabled" &&
        Number(service.enabled) !== 1
      ) {
        return false;
      }

      if (
        status === "disabled" &&
        Number(service.enabled) === 1
      ) {
        return false;
      }

      if (
        visibility === "visible" &&
        Number(service.clientVisible) !== 1
      ) {
        return false;
      }

      if (
        visibility === "hidden" &&
        Number(service.clientVisible) === 1
      ) {
        return false;
      }

      return true;
    });
  }

  function renderServicesAdmin() {
    const el = serviceElements();

    if (!el.list) {
      return;
    }

    const services = filteredServices();

    if (el.count) {
      el.count.textContent =
        `${services.length} serviço${services.length === 1 ? "" : "s"}`;
    }

    if (!services.length) {
      el.list.innerHTML = `
        <div class="service-empty">
          <strong>Nenhum serviço encontrado.</strong>
          <span>Ajuste os filtros ou cadastre um novo serviço.</span>
        </div>
      `;
      return;
    }

    el.list.innerHTML = services.map(service => {
      const enabled = Number(service.enabled) === 1;
      const visible = Number(service.clientVisible) === 1;

      return `
        <article class="service-admin-row">
          <div class="service-admin-main">
            <div class="service-admin-icon">🧩</div>

            <div class="service-admin-info">
              <strong>${servicesAdminEscape(service.name)}</strong>

              <span>
                ${servicesAdminEscape(service.description)}
              </span>

              <small>
                ${servicesAdminEscape(service.category)}
                · ID: ${servicesAdminEscape(service.id)}
              </small>
            </div>
          </div>

          <div class="service-admin-status">
            <span class="${enabled ? "service-status-on" : "service-status-off"}">
              ${enabled ? "🟢 Ativo" : "🔴 Inativo"}
            </span>

            <span class="${visible ? "service-status-visible" : "service-status-hidden"}">
              ${visible ? "👁 Visível" : "🚫 Oculto"}
            </span>
          </div>

          <div class="service-admin-actions">
            <button
              type="button"
              class="secondary-button service-edit-button"
              data-service-action="edit"
              data-service-id="${servicesAdminEscape(service.id)}"
            >
              Editar
            </button>

            <button
              type="button"
              class="secondary-button"
              data-service-action="toggle-status"
              data-service-id="${servicesAdminEscape(service.id)}"
            >
              ${enabled ? "Desativar" : "Ativar"}
            </button>

            <button
              type="button"
              class="secondary-button"
              data-service-action="toggle-visibility"
              data-service-id="${servicesAdminEscape(service.id)}"
            >
              ${visible ? "Ocultar" : "Mostrar"}
            </button>
          </div>
        </article>
      `;
    }).join("");
  }

  async function loadRealServicesAdmin() {
    const el = serviceElements();

    if (!el.page || !el.list) {
      return;
    }

    if (el.loading) {
      el.loading.hidden = false;
    }

    try {
      const result = await serviceApi("");

      servicesAdminData = Array.isArray(result.services)
        ? result.services
        : [];

      renderServiceMetrics();
      renderServicesAdmin();
    } catch (error) {
      console.error("SERVICES ADMIN:", error);

      el.list.innerHTML = `
        <div class="service-empty service-error">
          <strong>Não foi possível carregar os serviços.</strong>
          <span>${servicesAdminEscape(error.message)}</span>
        </div>
      `;
    } finally {
      if (el.loading) {
        el.loading.hidden = true;
      }
    }
  }

  function openServiceModal(service = null) {
    const el = serviceElements();

    if (!el.modal) {
      return;
    }

    editingServiceId = service?.id || null;

    el.modalTitle.textContent =
      service
        ? "Editar serviço"
        : "Novo serviço";

    el.id.value = service?.id || "";
    el.name.value = service?.name || "";
    el.description.value = service?.description || "";
    el.category.value = service?.category || "";
    el.enabledCheck.checked =
      service
        ? Number(service.enabled) === 1
        : true;

    el.visibleCheck.checked =
      service
        ? Number(service.clientVisible) === 1
        : true;

    el.formError.hidden = true;
    el.formError.textContent = "";

    el.modal.hidden = false;
    document.body.classList.add("service-modal-open");

    setTimeout(() => {
      el.name.focus();
    }, 50);
  }

  function closeServiceModal() {
    const el = serviceElements();

    if (!el.modal) {
      return;
    }

    el.modal.hidden = true;
    document.body.classList.remove("service-modal-open");
    editingServiceId = null;
  }

  async function saveService(event) {
    event.preventDefault();

    const el = serviceElements();

    const payload = {
      name: el.name.value.trim(),
      description: el.description.value.trim(),
      category: el.category.value.trim(),
      enabled: el.enabledCheck.checked,
      clientVisible: el.visibleCheck.checked
    };

    if (
      !payload.name ||
      !payload.description ||
      !payload.category
    ) {
      el.formError.textContent =
        "Preencha nome, descrição e categoria.";
      el.formError.hidden = false;
      return;
    }

    el.save.disabled = true;
    el.save.textContent = "Salvando...";

    try {
      if (editingServiceId) {
        await serviceApi(
          `/${encodeURIComponent(editingServiceId)}`,
          {
            method: "PATCH",
            body: JSON.stringify(payload)
          }
        );
      } else {
        await serviceApi(
          "",
          {
            method: "POST",
            body: JSON.stringify(payload)
          }
        );
      }

      closeServiceModal();
      await loadRealServicesAdmin();
    } catch (error) {
      console.error("SAVE SERVICE:", error);

      el.formError.textContent =
        error.message || "Não foi possível salvar o serviço.";
      el.formError.hidden = false;
    } finally {
      el.save.disabled = false;
      el.save.textContent = "Salvar serviço";
    }
  }

  async function toggleServiceStatus(service) {
    const enabled =
      Number(service.enabled) === 1;

    await serviceApi(
      `/${encodeURIComponent(service.id)}/status`,
      {
        method: "PATCH",
        body: JSON.stringify({
          enabled: !enabled
        })
      }
    );

    await loadRealServicesAdmin();
  }

  async function toggleServiceVisibility(service) {
    const visible =
      Number(service.clientVisible) === 1;

    await serviceApi(
      `/${encodeURIComponent(service.id)}/visibility`,
      {
        method: "PATCH",
        body: JSON.stringify({
          clientVisible: !visible
        })
      }
    );

    await loadRealServicesAdmin();
  }

  function bindServiceEvents() {
    const el = serviceElements();

    if (!el.page || el.page.dataset.servicesBound === "1") {
      return;
    }

    el.page.dataset.servicesBound = "1";

    el.search?.addEventListener(
      "input",
      renderServicesAdmin
    );

    el.status?.addEventListener(
      "change",
      renderServicesAdmin
    );

    el.visibility?.addEventListener(
      "change",
      renderServicesAdmin
    );

    document
      .getElementById("serviceRefreshButton")
      ?.addEventListener(
        "click",
        loadRealServicesAdmin
      );

    document
      .getElementById("serviceCreateButton")
      ?.addEventListener(
        "click",
        () => openServiceModal()
      );

    el.form?.addEventListener(
      "submit",
      saveService
    );

    el.page.addEventListener(
      "click",
      async event => {
        const close =
          event.target.closest(
            "[data-service-modal-close]"
          );

        if (close) {
          closeServiceModal();
          return;
        }

        const button =
          event.target.closest(
            "[data-service-action]"
          );

        if (!button) {
          return;
        }

        const serviceId =
          button.dataset.serviceId;

        const service =
          servicesAdminData.find(
            item => item.id === serviceId
          );

        if (!service) {
          return;
        }

        const action =
          button.dataset.serviceAction;

        try {
          button.disabled = true;

          if (action === "edit") {
            openServiceModal(service);
            return;
          }

          if (action === "toggle-status") {
            await toggleServiceStatus(service);
            return;
          }

          if (action === "toggle-visibility") {
            await toggleServiceVisibility(service);
          }
        } catch (error) {
          console.error("SERVICE ACTION:", error);
          alert(
            error.message ||
            "Não foi possível executar a ação."
          );
        } finally {
          button.disabled = false;
        }
      }
    );

    document.addEventListener(
      "keydown",
      event => {
        if (
          event.key === "Escape" &&
          !el.modal.hidden
        ) {
          closeServiceModal();
        }
      }
    );
  }

  window.loadRealServicesAdmin =
    loadRealServicesAdmin;

  function startRealServicesAdmin() {
    bindServiceEvents();

    const el = serviceElements();

    if (
      el.page &&
      el.page.classList.contains("active")
    ) {
      loadRealServicesAdmin();
    }
  }

  if (
    document.readyState === "loading"
  ) {
    document.addEventListener(
      "DOMContentLoaded",
      startRealServicesAdmin
    );
  } else {
    startRealServicesAdmin();
  }

  document.addEventListener(
    "click",
    event => {
      const button =
        event.target.closest(
          '[data-page="services"]'
        );

      if (!button) {
        return;
      }

      setTimeout(
        startRealServicesAdmin,
        100
      );
    }
  );
})();


// RESGATA+ REAL REQUESTS ADMIN UI
(function () {

  let requestsAdminData = [];
  let selectedRequestId = null;

  function requestToken() {
    return (
      localStorage.getItem("resgata_admin_token") ||
      localStorage.getItem("adminToken") ||
      localStorage.getItem("admin_token") ||
      ""
    );
  }

  function requestEscape(value) {
    return String(value ?? "")
      .replace(/&/g, "&amp;")
      .replace(/</g, "&lt;")
      .replace(/>/g, "&gt;")
      .replace(/"/g, "&quot;")
      .replace(/'/g, "&#039;");
  }

  async function requestApi(path = "", options = {}) {

    const response = await fetch(
      "/api/admin/requests" + path,
      {
        ...options,
        headers: {
          "Content-Type": "application/json",
          "Authorization": `Bearer ${requestToken()}`,
          ...(options.headers || {})
        }
      }
    );

    const data =
      await response.json().catch(() => ({}));

    if (!response.ok) {
      throw new Error(
        data.error ||
        `Erro HTTP ${response.status}`
      );
    }

    return data;
  }

  function requestElements() {
    return {
      page: document.getElementById("page-requests"),
      search: document.getElementById("requestSearch"),
      status: document.getElementById("requestStatusFilter"),
      service: document.getElementById("requestServiceFilter"),
      list: document.getElementById("requestsAdminList"),
      count: document.getElementById("requestResultCount"),
      loading: document.getElementById("requestLoading"),
      total: document.getElementById("requestMetricTotal"),
      pending: document.getElementById("requestMetricPending"),
      progress: document.getElementById("requestMetricProgress"),
      resolved: document.getElementById("requestMetricResolved"),
      cancelled: document.getElementById("requestMetricCancelled"),
      modal: document.getElementById("requestModal"),
      details: document.getElementById("requestDetails"),
      statusEdit: document.getElementById("requestStatusEdit"),
      saveStatus: document.getElementById("requestSaveStatus"),
      formError: document.getElementById("requestFormError")
    };
  }

  function requestStatusLabel(status) {

    const labels = {
      pending: "🟡 Pendente",
      received: "🟣 Recebida",
      in_progress: "🔵 Em andamento",
      waiting_user: "🟠 Aguardando usuário",
      waiting_specialist: "🟠 Aguardando especialista",
      resolved: "🟢 Resolvida",
      cancelled: "⚪ Cancelada",
      rejected: "🔴 Recusada"
    };

    return labels[status] || status || "Desconhecido";
  }

  function requestStatusClass(status) {

    return "request-status-" +
      String(status || "unknown")
        .replace(/[^a-z_]/g, "");
  }

  function requestDate(value) {

    if (!value) return "—";

    const date = new Date(value);

    if (Number.isNaN(date.getTime())) {
      return String(value);
    }

    return date.toLocaleString("pt-BR");
  }

  function requestUser(request) {
    return (
      request.user_name ||
      request.user_email ||
      request.user_id ||
      "Usuário não identificado"
    );
  }

  function requestService(request) {
    return (
      request.service_name ||
      request.service_id ||
      "Serviço não identificado"
    );
  }

  function renderRequestServices() {

    const el = requestElements();

    if (!el.service) return;

    const current = el.service.value;

    const services = Array.from(
      new Map(
        requestsAdminData
          .filter(item => item.service_id)
          .map(item => [
            item.service_id,
            {
              id: item.service_id,
              name:
                item.service_name ||
                item.service_id
            }
          ])
      ).values()
    );

    el.service.innerHTML = `
      <option value="all">
        Todos os serviços
      </option>

      ${services.map(service => `
        <option value="${requestEscape(service.id)}">
          ${requestEscape(service.name)}
        </option>
      `).join("")}
    `;

    if (
      services.some(
        service => service.id === current
      )
    ) {
      el.service.value = current;
    }
  }

  function renderRequestMetrics() {

    const el = requestElements();

    const total =
      requestsAdminData.length;

    const pending =
      requestsAdminData.filter(
        item => item.status === "pending"
      ).length;

    const progress =
      requestsAdminData.filter(
        item => item.status === "in_progress"
      ).length;

    const resolved =
      requestsAdminData.filter(
        item => item.status === "resolved"
      ).length;

    const cancelled =
      requestsAdminData.filter(
        item => item.status === "cancelled"
      ).length;

    if (el.total)
      el.total.textContent = total;

    if (el.pending)
      el.pending.textContent = pending;

    if (el.progress)
      el.progress.textContent = progress;

    if (el.resolved)
      el.resolved.textContent = resolved;

    if (el.cancelled)
      el.cancelled.textContent = cancelled;
  }

  function filteredRequests() {

    const el = requestElements();

    const search =
      (el.search?.value || "")
        .trim()
        .toLowerCase();

    const status =
      el.status?.value || "all";

    const service =
      el.service?.value || "all";

    return requestsAdminData.filter(request => {

      const text = [
        request.id,
        request.user_id,
        request.user_name,
        request.user_email,
        request.service_id,
        request.service_name,
        request.device_id,
        request.status
      ]
        .join(" ")
        .toLowerCase();

      if (
        search &&
        !text.includes(search)
      ) {
        return false;
      }

      if (
        status !== "all" &&
        request.status !== status
      ) {
        return false;
      }

      if (
        service !== "all" &&
        request.service_id !== service
      ) {
        return false;
      }

      return true;
    });
  }

  function renderRequests() {

    const el = requestElements();

    if (!el.list) return;

    const requests =
      filteredRequests();

    if (el.count) {
      el.count.textContent =
        `${requests.length} ${
          requests.length === 1
            ? "solicitação"
            : "solicitações"
        }`;
    }

    if (!requests.length) {

      el.list.innerHTML = `
        <div class="request-empty">
          <strong>
            Nenhuma solicitação encontrada.
          </strong>

          <span>
            As solicitações dos clientes
            aparecerão aqui.
          </span>
        </div>
      `;

      return;
    }

    el.list.innerHTML =
      requests.map(request => {

        const status =
          request.status || "pending";

        return `
          <article class="request-admin-row">

            <div class="request-admin-main">

              <div class="request-admin-icon">
                📋
              </div>

              <div class="request-admin-info">

                <strong>
                  ${requestEscape(
                    requestService(request)
                  )}
                </strong>

                <span>
                  ${requestEscape(
                    requestUser(request)
                  )}
                </span>

                <small>
                  ID:
                  ${requestEscape(request.id)}
                  ·
                  ${requestEscape(
                    request.device_id ||
                    "Sem dispositivo"
                  )}
                </small>

              </div>

            </div>

            <div class="request-admin-status">

              <span class="${requestStatusClass(status)}">
                ${requestEscape(
                  requestStatusLabel(status)
                )}
              </span>

              <small>
                ${requestEscape(
                  requestDate(request.created_at)
                )}
              </small>

            </div>

            <div class="request-admin-actions">

              <button
                type="button"
                class="secondary-button"
                data-request-action="details"
                data-request-id="${requestEscape(request.id)}"
              >
                Ver detalhes
              </button>

            </div>

          </article>
        `;

      }).join("");
  }

  async function loadRealRequestsAdmin() {

    const el = requestElements();

    if (!el.page || !el.list) {
      return;
    }

    if (el.loading) {
      el.loading.hidden = false;
    }

    try {

      const result =
        await requestApi("");

      requestsAdminData =
        Array.isArray(result.requests)
          ? result.requests
          : [];

      renderRequestServices();
      renderRequestMetrics();
      renderRequests();

    } catch (error) {

      console.error(
        "RESGATA REQUESTS ADMIN:",
        error
      );

      el.list.innerHTML = `
        <div class="request-empty request-error">
          <strong>
            Não foi possível carregar as solicitações.
          </strong>

          <span>
            ${requestEscape(error.message)}
          </span>
        </div>
      `;

    } finally {

      if (el.loading) {
        el.loading.hidden = true;
      }

    }
  }

  async function openRequestDetails(id) {

    const el = requestElements();

    try {

      const result =
        await requestApi(
          `/${encodeURIComponent(id)}`
        );

      const request =
        result.request || {};

      selectedRequestId =
        request.id;

      let details = request.details;

      if (
        typeof details === "object"
      ) {
        details =
          JSON.stringify(
            details,
            null,
            2
          );
      }

      if (!details) {
        details =
          "Nenhum detalhe adicional informado.";
      }

      el.details.innerHTML = `

        <div class="request-detail-grid">

          <div>
            <span>ID</span>
            <strong>
              ${requestEscape(request.id)}
            </strong>
          </div>

          <div>
            <span>Serviço</span>
            <strong>
              ${requestEscape(
                requestService(request)
              )}
            </strong>
          </div>

          <div>
            <span>Usuário</span>
            <strong>
              ${requestEscape(
                requestUser(request)
              )}
            </strong>
          </div>

          <div>
            <span>E-mail</span>
            <strong>
              ${requestEscape(
                request.user_email || "—"
              )}
            </strong>
          </div>

          <div>
            <span>Dispositivo</span>
            <strong>
              ${requestEscape(
                request.device_name ||
                request.device_id ||
                "—"
              )}
            </strong>
          </div>

          <div>
            <span>Criada em</span>
            <strong>
              ${requestEscape(
                requestDate(request.created_at)
              )}
            </strong>
          </div>

          <div>
            <span>Atualizada em</span>
            <strong>
              ${requestEscape(
                requestDate(request.updated_at)
              )}
            </strong>
          </div>

          <div>
            <span>Status atual</span>
            <strong>
              ${requestEscape(
                requestStatusLabel(
                  request.status
                )
              )}
            </strong>
          </div>

        </div>

        <div class="request-details-content">

          <strong>
            Detalhes enviados
          </strong>

          <pre>${requestEscape(details)}</pre>

        </div>
      `;

      el.statusEdit.value =
        request.status || "pending";

      el.formError.hidden = true;

      el.modal.hidden = false;

      document.body.classList.add(
        "request-modal-open"
      );

    } catch (error) {

      console.error(
        "RESGATA REQUEST DETAIL:",
        error
      );

      alert(
        error.message ||
        "Não foi possível abrir a solicitação."
      );
    }
  }

  function closeRequestModal() {

    const el = requestElements();

    if (!el.modal) return;

    el.modal.hidden = true;

    document.body.classList.remove(
      "request-modal-open"
    );

    selectedRequestId = null;
  }

  async function saveRequestStatus() {

    const el = requestElements();

    if (
      !selectedRequestId ||
      !el.statusEdit
    ) {
      return;
    }

    el.saveStatus.disabled = true;
    el.saveStatus.textContent =
      "Salvando...";

    try {

      await requestApi(
        `/${encodeURIComponent(
          selectedRequestId
        )}/status`,
        {
          method: "PATCH",
          body: JSON.stringify({
            status:
              el.statusEdit.value
          })
        }
      );

      closeRequestModal();

      await loadRealRequestsAdmin();

    } catch (error) {

      console.error(
        "RESGATA REQUEST STATUS:",
        error
      );

      el.formError.textContent =
        error.message ||
        "Não foi possível atualizar o status.";

      el.formError.hidden = false;

    } finally {

      el.saveStatus.disabled = false;
      el.saveStatus.textContent =
        "Salvar status";
    }
  }

  function bindRequestEvents() {

    const el = requestElements();

    if (
      !el.page ||
      el.page.dataset.requestsBound === "1"
    ) {
      return;
    }

    el.page.dataset.requestsBound = "1";

    el.search?.addEventListener(
      "input",
      renderRequests
    );

    el.status?.addEventListener(
      "change",
      renderRequests
    );

    el.service?.addEventListener(
      "change",
      renderRequests
    );

    document
      .getElementById(
        "requestRefreshButton"
      )
      ?.addEventListener(
        "click",
        loadRealRequestsAdmin
      );

    el.saveStatus?.addEventListener(
      "click",
      saveRequestStatus
    );

    el.page.addEventListener(
      "click",
      async event => {

        const close =
          event.target.closest(
            "[data-request-modal-close]"
          );

        if (close) {
          closeRequestModal();
          return;
        }

        const button =
          event.target.closest(
            "[data-request-action]"
          );

        if (!button) return;

        if (
          button.dataset.requestAction ===
          "details"
        ) {

          await openRequestDetails(
            button.dataset.requestId
          );
        }

      }
    );

    document.addEventListener(
      "keydown",
      event => {

        const modal =
          document.getElementById(
            "requestModal"
          );

        if (
          event.key === "Escape" &&
          modal &&
          !modal.hidden
        ) {
          closeRequestModal();
        }

      }
    );
  }

  function startRequestsAdmin() {

    bindRequestEvents();

    const el = requestElements();

    if (
      el.page &&
      el.page.classList.contains("active")
    ) {
      loadRealRequestsAdmin();
    }
  }

  window.loadRealRequestsAdmin =
    loadRealRequestsAdmin;

  if (
    document.readyState === "loading"
  ) {

    document.addEventListener(
      "DOMContentLoaded",
      startRequestsAdmin
    );

  } else {

    startRequestsAdmin();

  }

})();


