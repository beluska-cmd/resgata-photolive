  });
}

function bettingDate(value) {
  if (!value) return "—";

  try {
    return new Date(value).toLocaleString("pt-BR");
  } catch {
    return String(value);
  }
}

function bettingProtectionBadge(level) {
  const value = String(level || "normal").toLowerCase();

  const labels = {
    normal: "Normal",
    strong: "Forte",
    maximum: "Máxima",
    max: "Máxima",
    sair_de_vez: "Sair de Vez"
  };

  return labels[value] || level || "Normal";
}

function bettingStatusBadge(enabled) {
  return Number(enabled) === 1 || enabled === true
    ? '<span class="status-badge status-active">Ativo</span>'
    : '<span class="status-badge status-inactive">Inativo</span>';
}


