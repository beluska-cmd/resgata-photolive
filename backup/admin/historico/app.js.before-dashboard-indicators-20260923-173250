async function loadBettingFinancial() {
  try {
    const result = await api(
      "/api/admin/betting-protection/financial"
    );

    const financial =
      result?.financial ||
      result?.data?.financial ||
      result?.data ||
      result ||
      {};

    /*
     * O valor protegido é sempre tratado separadamente
     * dos valores imaginados e dos resultados históricos.
     */

    const protectedMoney =
      Number(
        financial.protectedMoney ??
        financial.totalProtected ??
        financial.valorProtegido ??
        financial.total_protected ??
        0
      );

    const financialRecords =
      Number(
        financial.records ??
        financial.totalRecords ??
        financial.total_registros ??
        financial.count ??
        0
      );

    const protectedElement =
      document.getElementById("bettingProtectedMoney");

    const recordsElement =
      document.getElementById("bettingFinancialRecords");

    if (protectedElement) {
      protectedElement.textContent =
        bettingMoney(protectedMoney);
    }

    if (recordsElement) {
      recordsElement.textContent =
        String(financialRecords);
    }

    /*
     * Se existir uma área específica para detalhes financeiros,
     * preenchemos automaticamente.
     */

    const detailContainer =
      document.getElementById("bettingFinancialList");

    if (detailContainer) {

      const records =
        financial.recordsList ||
        financial.records_data ||
        financial.items ||
        financial.history ||
        [];

      if (Array.isArray(records) && records.length) {

        detailContainer.innerHTML =
          records.map(record => {

            const value =
              Number(
                record.valor ??
                record.value ??
                record.valor_protegido ??
                record.protected_value ??
                0
              );

            const date =
              record.data ||
              record.date ||
              record.created_at ||
              record.criado_em;

            const account =
              record.conta ||
              record.nome_conta ||
              record.account_name ||
              "Sem conta associada";

            return `
              <div class="admin-list-item financial-item">

                <div>
                  <strong>
                    ${escapeHtml(bettingMoney(value))}
                  </strong>

                  <small>
                    ${escapeHtml(String(account))}
                  </small>
                </div>

                <small>
                  ${escapeHtml(bettingDate(date))}
                </small>

              </div>
            `;
          }).join("");

      } else {

        detailContainer.innerHTML = `
          <div class="empty-state">
            Nenhum registro financeiro encontrado.
          </div>
        `;
      }
    }

    /*
     * Elementos opcionais para mostrar os resultados históricos.
     */

    const imaginedGain =
      Number(
        financial.imaginedGain ??
        financial.totalImaginedGain ??
        financial.valorGanhoImaginado ??
        0
      );

    const imaginedWithdrawal =
      Number(
        financial.imaginedWithdrawal ??
        financial.totalImaginedWithdrawal ??
        financial.valorSaqueImaginado ??
        0
      );

    const reportedGain =
      Number(
        financial.reportedGain ??
        financial.totalReportedGain ??
        financial.valorGanhoInformado ??
        0
      );

    const reportedLoss =
      Number(
        financial.reportedLoss ??
        financial.totalReportedLoss ??
        financial.valorPerdidoInformado ??
        0
      );

    const elementMap = {
      bettingImaginedGain: imaginedGain,
      bettingImaginedWithdrawal: imaginedWithdrawal,
      bettingReportedGain: reportedGain,
      bettingReportedLoss: reportedLoss
    };

    Object.entries(elementMap).forEach(
      ([elementId, value]) => {

        const element =
          document.getElementById(elementId);

        if (element) {
          element.textContent =
            bettingMoney(value);
        }
      }
    );

  } catch (error) {

    console.error(
      "ERRO AO CARREGAR DINHEIRO PROTEGIDO:",
      error
    );

    const protectedElement =
      document.getElementById("bettingProtectedMoney");

    if (protectedElement) {
      protectedElement.textContent = "—";
    }

    const recordsElement =
      document.getElementById("bettingFinancialRecords");

    if (recordsElement) {
      recordsElement.textContent = "—";
    }
  }
}


