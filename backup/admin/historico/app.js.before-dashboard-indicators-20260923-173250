    document.getElementById("dashboardCommandCenter");

  if (!container) {
    return;
  }

  try {

    const [
      today,
      week,
      emergency,
      suggestions,
      content
    ] = await Promise.all([
      api("/api/admin/reports?period=today"),
      api("/api/admin/reports?period=7d"),
      api("/api/admin/emergency?limit=100"),
      api("/api/admin/suggestions?limit=100"),
      api("/api/admin/content?limit=100")
    ]);

    renderDashboardCommandCenter({
      today,
      week,
      emergency,
      suggestions,
      content
    });

  } catch (error) {

    console.error(
      "DASHBOARD COMMAND CENTER ERROR:",
      error
    );

    container.innerHTML = `
      <div class="panel">
        <div class="panel-header">
          <div>
            <span class="panel-eyebrow">
              CENTRAL DE COMANDO
