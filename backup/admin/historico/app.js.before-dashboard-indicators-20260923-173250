async function loadBettingMissions() {

  try {

    const result =
      await api(
        "/api/admin/betting-protection/missions"
      );

    const missions =
      result?.missions ||
      result?.data?.missions ||
      result?.data ||
      [];

    const list =
      Array.isArray(missions)
        ? missions
        : [];

    /*
     * Total de missões concluídas
     */

    const completed =
      list.filter(mission =>
        Number(
          mission.concluida ??
          mission.completed ??
          mission.completed_flag ??
          0
        ) === 1
      ).length;

    const completedElement =
      document.getElementById(
        "bettingCompletedMissions"
      );

    if (completedElement) {
      completedElement.textContent =
        String(completed);
    }

    /*
     * Lista detalhada
     */

    const container =
      document.getElementById(
        "bettingMissionsList"
      );

    if (!container) {
      return;
    }

    if (!list.length) {

      container.innerHTML = `
        <div class="empty-state">

          <strong>
            Nenhuma missão registrada.
          </strong>

          <p>
            As missões diárias aparecerão aqui
            quando os usuários começarem a registrar
            sua evolução.
          </p>

        </div>
      `;

      return;
    }

    container.innerHTML =
      list.map(mission => {

        const date =
          mission.data ||
          mission.date ||
          mission.created_at ||
          mission.criado_em;

        const didNotBet =
          Number(
            mission.nao_apostou ??
            mission.did_not_bet ??
            0
          ) === 1;

        const hadUrge =
          Number(
            mission.teve_vontade ??
            mission.had_urge ??
            0
          ) === 1;

        const value =
          Number(
            mission.valor_protegido ??
            mission.protected_value ??
            mission.valor ??
            0
          );

        const completedMission =
          Number(
            mission.concluida ??
            mission.completed ??
            0
          ) === 1;

        const userId =
          mission.usuario_id ??
          mission.user_id ??
          "—";

        return `
          <div class="admin-list-item mission-item">

            <div>

              <strong>
                ${escapeHtml(String(date || "Data não informada"))}
              </strong>

              <small>
                Usuário:
                ${escapeHtml(String(userId))}
              </small>

              <small>
                ${didNotBet
                  ? "✓ Não apostou"
                  : "Não marcado como não apostou"}
              </small>

              <small>
                ${hadUrge
                  ? "⚠ Teve vontade de apostar"
                  : "Sem vontade registrada"}
              </small>

            </div>

            <div>

              <strong>
                ${escapeHtml(bettingMoney(value))}
              </strong>

              <small>
                ${completedMission
                  ? "✓ Missão concluída"
                  : "Missão não concluída"}
              </small>

            </div>

          </div>
        `;
      }).join("");

  } catch (error) {

    console.error(
      "ERRO AO CARREGAR MISSOES:",
      error
    );

    const completedElement =
      document.getElementById(
        "bettingCompletedMissions"
      );

    if (completedElement) {
      completedElement.textContent = "—";
    }

    const container =
      document.getElementById(
        "bettingMissionsList"
      );

    if (container) {
      container.innerHTML = `
        <div class="empty-state error">
          Não foi possível carregar as missões.
        </div>
      `;
    }
  }
}


