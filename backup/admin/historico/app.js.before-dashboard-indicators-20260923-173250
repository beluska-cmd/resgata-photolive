            <span>
              ${escapeHtml(
                service.category || ""
              )}
            </span>

          </div>

          <span class="
            status-badge
            ${enabled
              ? "success"
              : "disabled"}
          ">
            ${enabled
              ? "Ativo"
              : "Desativado"}
          </span>

        </div>
      `;

    }).join("");
}


