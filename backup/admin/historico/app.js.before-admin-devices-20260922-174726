function formatDate(value) {

  if (!value) {
    return "-";
  }

  const numeric =
    Number(value);

  const date =
    Number.isFinite(numeric)
      ? new Date(numeric)
      : new Date(value);

  if (Number.isNaN(
    date.getTime()
  )) {
    return String(value);
  }

  return date.toLocaleDateString(
    "pt-BR"
  );
}


