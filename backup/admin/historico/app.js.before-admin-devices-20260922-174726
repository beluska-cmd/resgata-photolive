function renderSecurityAlerts(events) {

  const box =
    document.getElementById(
      "alertsList"
    );

  const unresolved =
    events.filter(
      event =>
        Number(event.resolved) === 0
    );

  if (!unresolved.length) {

    box.innerHTML = `
      <div class="no-alert">
        <span>✓</span>
        <div>
          <strong>
            Nenhum alerta pendente
          </strong>
          <p>
            Não há eventos de segurança pendentes.
          </p>
        </div>
      </div>
    `;

    return;
  }

  box.innerHTML =
    unresolved
      .slice(0, 6)
      .map(event => {

        return `
          <div class="
            alert-row
            ${escapeHtml(
              event.severity || "info"
            )}
          ">

            <div class="alert-icon">
              ${event.severity === "high"
                ? "🔴"
                : event.severity === "medium"
                  ? "🟠"
                  : "🔵"}
            </div>

            <div>

              <strong>
                ${escapeHtml(
                  event.title ||
                  "Evento de segurança"
                )}
              </strong>

              <p>
                ${escapeHtml(
                  event.description || ""
                )}
              </p>

            </div>

          </div>
        `;

      }).join("");
}


