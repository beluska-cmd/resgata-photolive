          `/api/admin/users/${encodeURIComponent(user.id)}/status`,
          {
            method: "PATCH",
            body: {
              status
            }
          }
        );

        showToast(
          "Status do usuário atualizado.",
          "success"
        );

        await loadUsers();

        await openUserDrawer(
          user.id
        );

      } catch (error) {

        showToast(
          error.message,
          "error"
        );

      }

    }
  );


  document.getElementById(
    "saveUserPlan"
  )?.addEventListener(
    "click",
    async () => {

      const plan =
        document.getElementById(
          "drawerPlan"
        ).value;

      try {

        await api(
          `/api/admin/users/${encodeURIComponent(user.id)}/plan`,
          {
            method: "PATCH",
            body: {
              plan
            }
          }
        );

        showToast(
          "Plano do usuário atualizado.",
          "success"
        );

        await loadUsers();

        await openUserDrawer(
          user.id
        );

      } catch (error) {

        showToast(
          error.message,
          "error"
        );

      }

    }
  );

}


