      "userDrawer"
    );

  const content =
    document.getElementById(
      "drawerContent"
    );

  backdrop.classList.add(
    "open"
  );

  content.innerHTML = `
    <div class="loading">
      Carregando perfil...
    </div>
  `;

  try {

    const data =
      await api(
        `/api/admin/users/${encodeURIComponent(userId)}`
