async function loadAdmin() {

  if (!token()) {

    location.href =
      "/admin/login.html";

    return null;
  }

  try {

    const data =
      await api("/api/admin/me");

    admin = data.admin;

    document.getElementById(
      "sidebarAdminName"
    ).textContent =
      admin.name || "Administrador";

    document.getElementById(
      "sidebarAdminRole"
    ).textContent =
      admin.role || "admin";

    return admin;

  } catch (error) {

    showToast(
      error.message,
      "error"
    );

    return null;
  }
}


