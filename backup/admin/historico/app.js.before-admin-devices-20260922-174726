)?.addEventListener(
  "click",
  loadUsers
);


document.getElementById(
  "usersStatus"
)?.addEventListener(
  "change",
  loadUsers
);


document.getElementById(
  "usersPlan"
)?.addEventListener(
  "change",
  loadUsers
);


document.getElementById(
  "usersSearch"
)?.addEventListener(
  "input",
  () => {

    clearTimeout(
      usersSearchTimer
    );

    usersSearchTimer =
      setTimeout(
        loadUsers,
        350
      );

  }
);


document.getElementById(
  "closeUserDrawer"
)?.addEventListener(
  "click",
  () => {

    document
      .getElementById(
        "userDrawer"
      )
      .classList.remove(
        "open"
      );

  }
);


document.getElementById(
  "userDrawer"
)?.addEventListener(
  "click",
  event => {

    if (
      event.target.id ===
      "userDrawer"
    ) {

      event.currentTarget
        .classList.remove(
          "open"
        );

    }

  }
);


