// DASHBOARD
// ============================================================

async function loadDashboard() {

  try {

    const [
      dashboardData,
      coreSummary,
      services,
      specialists,
      security
    ] = await Promise.all([
      api("/api/admin/dashboard"),
      api("/api/admin/core-summary"),
      api("/api/admin/services"),
      api("/api/admin/specialists"),
      api("/api/admin/security/events?limit=20")
    ]);

    dashboard = dashboardData;

    renderMetrics(
      dashboardData,
      coreSummary
    );

    renderServices(
      services.services || []
    );

    renderSpecialists(
      specialists.specialists || []
    );

    renderSecurityAlerts(
      security.events || []
    );

    renderActivity(
      dashboardData
    );

    renderProtection(
      coreSummary.summary || {}
    );

    document.getElementById(
      "lastUpdate"
    ).textContent =
      `Atualizado às ${new Date().toLocaleTimeString("pt-BR")}`;

  } catch (error) {

    console.error(error);

    showToast(
      `Erro no dashboard: ${error.message}`,
      "error"
    );
  }
}


