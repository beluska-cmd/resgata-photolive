// RESGATA+ SERVICES API INTEGRATION
(function () {
  const originalLoad = window.loadPageData;

  async function getAdminToken() {
    return (
      localStorage.getItem("resgata_admin_token") ||
      sessionStorage.getItem("resgata_admin_token") ||
      ""
    );
  }

  async function servicesApi(path = "", options = {}) {
    const token = await getAdminToken();

    const response = await fetch("/api/admin/services" + path, {
      ...options,
      headers: {
        "Content-Type": "application/json",
        "Authorization": "Bearer " + token,
        ...(options.headers || {})
      }
    });

    const data = await response.json().catch(() => ({}));

    if (response.status === 401) {
      throw new Error("Sessão administrativa expirada.");
    }

    if (!response.ok || data.ok === false) {
      throw new Error(data.error || "Erro na API de serviços.");
    }

    return data;
  }

  async function loadServicesAdmin() {
    const page = document.getElementById("page-services");

    if (!page) return;

    try {
      const result = await servicesApi("");
      const services = result.services || [];

      const overview = document.getElementById("servicesOverview");

      if (overview) {
        overview.innerHTML = services.length
          ? services.map(service => `
              <div class="service-overview-item"
                   style="padding:14px;border:1px solid #e5e7eb;border-radius:12px;margin-bottom:10px;">
                <div style="display:flex;justify-content:space-between;gap:12px;align-items:center;">
                  <strong>${escapeHtmlServices(service.name)}</strong>
                  <span>
                    ${Number(service.enabled) === 1 ? "🟢 Ativo" : "🔴 Inativo"}
                  </span>
                </div>

                <div style="font-size:13px;color:#6b7280;margin-top:5px;">
                  ${escapeHtmlServices(service.category || "")}
                </div>

                <div style="font-size:13px;margin-top:5px;">
                  ${Number(service.clientVisible) === 1
                    ? "👁️ Visível para clientes"
                    : "🙈 Oculto para clientes"}
                </div>
              </div>
            `).join("")
          : "<p>Nenhum serviço cadastrado.</p>";
      }

      const loading = page.querySelector("[data-services-loading]");

      if (loading) {
        loading.remove();
      }

    } catch (error) {
      console.error("SERVICES ADMIN:", error);

      const overview = document.getElementById("servicesOverview");

      if (overview) {
        overview.innerHTML = `
          <div style="padding:15px;border-radius:10px;background:#fee2e2;color:#991b1b;">
            Erro ao carregar serviços: ${escapeHtmlServices(error.message)}
          </div>
        `;
      }
    }
  }

  function escapeHtmlServices(value) {
    return String(value ?? "")
      .replaceAll("&", "&amp;")
      .replaceAll("<", "&lt;")
      .replaceAll(">", "&gt;")
      .replaceAll('"', "&quot;")
      .replaceAll("'", "&#039;");
  }

  window.loadServicesAdmin = loadServicesAdmin;

  document.addEventListener("DOMContentLoaded", () => {
    setTimeout(loadServicesAdmin, 200);
  });

  document.addEventListener("click", event => {
    const button = event.target.closest('[data-page="services"]');

    if (!button) return;

    setTimeout(loadServicesAdmin, 250);
  });
})();


// RESGATA+ REAL SERVICES ADMIN UI
(function () {
  let servicesAdminData = [];
  let editingServiceId = null;

  function servicesAdminEscape(value) {
    return String(value ?? "")
      .replace(/&/g, "&amp;")
      .replace(/</g, "&lt;")
      .replace(/>/g, "&gt;")
      .replace(/"/g, "&quot;")
      .replace(/'/g, "&#039;");
  }

  function serviceApiHeaders() {
    const token =
      localStorage.getItem("resgata_admin_token") ||
      localStorage.getItem("adminToken") ||
      localStorage.getItem("admin_token") ||
      "";

    return {
      "Content-Type": "application/json",
      "Authorization": token ? `Bearer ${token}` : ""
    };
  }

  async function serviceApi(path = "", options = {}) {
    const response = await fetch(
      "/api/admin/services" + path,
      {
        ...options,
        headers: {
          ...serviceApiHeaders(),
          ...(options.headers || {})
        }
      }
    );

    const data = await response.json().catch(() => ({}));

    if (!response.ok) {
      throw new Error(
        data.error ||
        `Erro HTTP ${response.status}`
      );
    }

    return data;
  }

  function serviceElements() {
    return {
      page: document.getElementById("page-services"),
      search: document.getElementById("serviceSearch"),
      status: document.getElementById("serviceStatusFilter"),
      visibility: document.getElementById("serviceVisibilityFilter"),
      list: document.getElementById("servicesAdminList"),
      count: document.getElementById("serviceResultCount"),
      loading: document.getElementById("serviceLoading"),
      total: document.getElementById("serviceMetricTotal"),
      enabled: document.getElementById("serviceMetricEnabled"),
      disabled: document.getElementById("serviceMetricDisabled"),
      visible: document.getElementById("serviceMetricVisible"),
      hidden: document.getElementById("serviceMetricHidden"),
      modal: document.getElementById("serviceModal"),
      modalTitle: document.getElementById("serviceModalTitle"),
      form: document.getElementById("serviceForm"),
      id: document.getElementById("serviceId"),
      name: document.getElementById("serviceName"),
      description: document.getElementById("serviceDescription"),
      category: document.getElementById("serviceCategory"),
      enabledCheck: document.getElementById("serviceEnabled"),
      visibleCheck: document.getElementById("serviceVisible"),
      formError: document.getElementById("serviceFormError"),
      save: document.getElementById("serviceSaveButton")
    };
  }

  function renderServiceMetrics() {
    const el = serviceElements();

    const total = servicesAdminData.length;
    const enabled = servicesAdminData.filter(
      service => Number(service.enabled) === 1
    ).length;

    const visible = servicesAdminData.filter(
      service => Number(service.clientVisible) === 1
    ).length;

    if (el.total) el.total.textContent = total;
    if (el.enabled) el.enabled.textContent = enabled;
    if (el.disabled) el.disabled.textContent = total - enabled;
    if (el.visible) el.visible.textContent = visible;
    if (el.hidden) el.hidden.textContent = total - visible;
  }

  function filteredServices() {
    const el = serviceElements();

    const search = (
      el.search?.value ||
      ""
    ).trim().toLowerCase();

    const status = el.status?.value || "all";
    const visibility = el.visibility?.value || "all";

    return servicesAdminData.filter(service => {
      const haystack = [
        service.name,
        service.description,
        service.category,
        service.id
      ]
        .join(" ")
        .toLowerCase();

      if (search && !haystack.includes(search)) {
        return false;
      }

      if (
        status === "enabled" &&
        Number(service.enabled) !== 1
      ) {
        return false;
      }

      if (
        status === "disabled" &&
        Number(service.enabled) === 1
      ) {
        return false;
      }

      if (
        visibility === "visible" &&
        Number(service.clientVisible) !== 1
      ) {
        return false;
      }

      if (
        visibility === "hidden" &&
        Number(service.clientVisible) === 1
      ) {
        return false;
      }

      return true;
    });
  }

  function renderServicesAdmin() {
    const el = serviceElements();

    if (!el.list) {
      return;
    }

    const services = filteredServices();

    if (el.count) {
      el.count.textContent =
        `${services.length} serviço${services.length === 1 ? "" : "s"}`;
    }

    if (!services.length) {
      el.list.innerHTML = `
        <div class="service-empty">
          <strong>Nenhum serviço encontrado.</strong>
          <span>Ajuste os filtros ou cadastre um novo serviço.</span>
        </div>
      `;
      return;
    }

    el.list.innerHTML = services.map(service => {
      const enabled = Number(service.enabled) === 1;
      const visible = Number(service.clientVisible) === 1;

      return `
        <article class="service-admin-row">
          <div class="service-admin-main">
            <div class="service-admin-icon">🧩</div>

            <div class="service-admin-info">
              <strong>${servicesAdminEscape(service.name)}</strong>

              <span>
                ${servicesAdminEscape(service.description)}
              </span>

              <small>
                ${servicesAdminEscape(service.category)}
                · ID: ${servicesAdminEscape(service.id)}
              </small>
            </div>
          </div>

          <div class="service-admin-status">
            <span class="${enabled ? "service-status-on" : "service-status-off"}">
              ${enabled ? "🟢 Ativo" : "🔴 Inativo"}
            </span>

            <span class="${visible ? "service-status-visible" : "service-status-hidden"}">
              ${visible ? "👁 Visível" : "🚫 Oculto"}
            </span>
          </div>

          <div class="service-admin-actions">
            <button
              type="button"
              class="secondary-button service-edit-button"
              data-service-action="edit"
              data-service-id="${servicesAdminEscape(service.id)}"
            >
              Editar
            </button>

            <button
              type="button"
              class="secondary-button"
              data-service-action="toggle-status"
              data-service-id="${servicesAdminEscape(service.id)}"
            >
              ${enabled ? "Desativar" : "Ativar"}
            </button>

            <button
              type="button"
              class="secondary-button"
              data-service-action="toggle-visibility"
              data-service-id="${servicesAdminEscape(service.id)}"
            >
              ${visible ? "Ocultar" : "Mostrar"}
            </button>
          </div>
        </article>
      `;
    }).join("");
  }

  async function loadRealServicesAdmin() {
    const el = serviceElements();

    if (!el.page || !el.list) {
      return;
    }

    if (el.loading) {
      el.loading.hidden = false;
    }

    try {
      const result = await serviceApi("");

      servicesAdminData = Array.isArray(result.services)
        ? result.services
        : [];

      renderServiceMetrics();
      renderServicesAdmin();
    } catch (error) {
      console.error("SERVICES ADMIN:", error);

      el.list.innerHTML = `
        <div class="service-empty service-error">
          <strong>Não foi possível carregar os serviços.</strong>
          <span>${servicesAdminEscape(error.message)}</span>
        </div>
      `;
    } finally {
      if (el.loading) {
        el.loading.hidden = true;
      }
    }
  }

  function openServiceModal(service = null) {
    const el = serviceElements();

    if (!el.modal) {
      return;
    }

    editingServiceId = service?.id || null;

    el.modalTitle.textContent =
      service
        ? "Editar serviço"
        : "Novo serviço";

    el.id.value = service?.id || "";
    el.name.value = service?.name || "";
    el.description.value = service?.description || "";
    el.category.value = service?.category || "";
    el.enabledCheck.checked =
      service
        ? Number(service.enabled) === 1
        : true;

    el.visibleCheck.checked =
      service
        ? Number(service.clientVisible) === 1
        : true;

    el.formError.hidden = true;
    el.formError.textContent = "";

    el.modal.hidden = false;
    document.body.classList.add("service-modal-open");

    setTimeout(() => {
      el.name.focus();
    }, 50);
  }

  function closeServiceModal() {
    const el = serviceElements();

    if (!el.modal) {
      return;
    }

    el.modal.hidden = true;
    document.body.classList.remove("service-modal-open");
    editingServiceId = null;
  }

  async function saveService(event) {
    event.preventDefault();

    const el = serviceElements();

    const payload = {
      name: el.name.value.trim(),
      description: el.description.value.trim(),
      category: el.category.value.trim(),
      enabled: el.enabledCheck.checked,
      clientVisible: el.visibleCheck.checked
    };

    if (
      !payload.name ||
      !payload.description ||
      !payload.category
    ) {
      el.formError.textContent =
        "Preencha nome, descrição e categoria.";
      el.formError.hidden = false;
      return;
    }

    el.save.disabled = true;
    el.save.textContent = "Salvando...";

    try {
      if (editingServiceId) {
        await serviceApi(
          `/${encodeURIComponent(editingServiceId)}`,
          {
            method: "PATCH",
            body: JSON.stringify(payload)
          }
        );
      } else {
        await serviceApi(
          "",
          {
            method: "POST",
            body: JSON.stringify(payload)
          }
        );
      }

      closeServiceModal();
      await loadRealServicesAdmin();
    } catch (error) {
      console.error("SAVE SERVICE:", error);

      el.formError.textContent =
        error.message || "Não foi possível salvar o serviço.";
      el.formError.hidden = false;
    } finally {
      el.save.disabled = false;
      el.save.textContent = "Salvar serviço";
    }
  }

  async function toggleServiceStatus(service) {
    const enabled =
      Number(service.enabled) === 1;

    await serviceApi(
      `/${encodeURIComponent(service.id)}/status`,
      {
        method: "PATCH",
        body: JSON.stringify({
          enabled: !enabled
        })
      }
    );

    await loadRealServicesAdmin();
  }

  async function toggleServiceVisibility(service) {
    const visible =
      Number(service.clientVisible) === 1;

    await serviceApi(
      `/${encodeURIComponent(service.id)}/visibility`,
      {
        method: "PATCH",
        body: JSON.stringify({
          clientVisible: !visible
        })
      }
    );

    await loadRealServicesAdmin();
  }

  function bindServiceEvents() {
    const el = serviceElements();

    if (!el.page || el.page.dataset.servicesBound === "1") {
      return;
    }

    el.page.dataset.servicesBound = "1";

    el.search?.addEventListener(
      "input",
      renderServicesAdmin
    );

    el.status?.addEventListener(
      "change",
      renderServicesAdmin
    );

    el.visibility?.addEventListener(
      "change",
      renderServicesAdmin
    );

    document
      .getElementById("serviceRefreshButton")
      ?.addEventListener(
        "click",
        loadRealServicesAdmin
      );

    document
      .getElementById("serviceCreateButton")
      ?.addEventListener(
        "click",
        () => openServiceModal()
      );

    el.form?.addEventListener(
      "submit",
      saveService
    );

    el.page.addEventListener(
      "click",
      async event => {
        const close =
          event.target.closest(
            "[data-service-modal-close]"
          );

        if (close) {
          closeServiceModal();
          return;
        }

        const button =
          event.target.closest(
            "[data-service-action]"
          );

        if (!button) {
          return;
        }

        const serviceId =
          button.dataset.serviceId;

        const service =
          servicesAdminData.find(
            item => item.id === serviceId
          );

        if (!service) {
          return;
        }

        const action =
          button.dataset.serviceAction;

        try {
          button.disabled = true;

          if (action === "edit") {
            openServiceModal(service);
            return;
          }

          if (action === "toggle-status") {
            await toggleServiceStatus(service);
            return;
          }

          if (action === "toggle-visibility") {
            await toggleServiceVisibility(service);
          }
        } catch (error) {
          console.error("SERVICE ACTION:", error);
          alert(
            error.message ||
            "Não foi possível executar a ação."
          );
        } finally {
          button.disabled = false;
        }
      }
    );

    document.addEventListener(
      "keydown",
      event => {
        if (
          event.key === "Escape" &&
          !el.modal.hidden
        ) {
          closeServiceModal();
        }
      }
    );
  }

  window.loadRealServicesAdmin =
    loadRealServicesAdmin;

  function startRealServicesAdmin() {
    bindServiceEvents();

    const el = serviceElements();

    if (
      el.page &&
      el.page.classList.contains("active")
    ) {
      loadRealServicesAdmin();
    }
  }

  if (
    document.readyState === "loading"
  ) {
    document.addEventListener(
      "DOMContentLoaded",
      startRealServicesAdmin
    );
  } else {
    startRealServicesAdmin();
  }

  document.addEventListener(
    "click",
    event => {
      const button =
        event.target.closest(
          '[data-page="services"]'
        );

      if (!button) {
        return;
      }

      setTimeout(
        startRealServicesAdmin,
        100
      );
    }
  );
})();

