:root {
  --bg: #f4f7fb;
  --card: #ffffff;
  --text: #172033;
  --muted: #69778c;
  --border: #e3e8ef;

  --primary: #1769e0;
  --primary-dark: #0f51b3;

  --success: #15834c;
  --warning: #c77700;
  --danger: #c93636;

  --sidebar: #101827;
  --sidebar-hover: #1a2538;

  --shadow:
    0 10px 35px rgba(16, 24, 39, .06);
}

* {
  box-sizing: border-box;
}

html,
body {
  margin: 0;
  padding: 0;
  min-height: 100%;
}

body {
  background: var(--bg);
  color: var(--text);
  font-family:
    Inter,
    ui-sans-serif,
    system-ui,
    -apple-system,
    BlinkMacSystemFont,
    "Segoe UI",
    sans-serif;
}

button,
input,
select,
textarea {
  font: inherit;
}

button {
  cursor: pointer;
}

.admin-app {
  min-height: 100vh;
  display: flex;
}


/* ==========================================================
   SIDEBAR
   ========================================================== */

.sidebar {
  width: 265px;
  min-height: 100vh;

  background: var(--sidebar);
  color: #e8eef7;

  display: flex;
  flex-direction: column;

  position: fixed;
  left: 0;
  top: 0;
  bottom: 0;

  z-index: 100;
}

.sidebar-brand {
  height: 76px;

  display: flex;
  align-items: center;

  gap: 12px;

  padding: 0 20px;

  border-bottom:
    1px solid rgba(255,255,255,.08);
}

.brand-symbol {
  width: 42px;
  height: 42px;

  border-radius: 12px;

  display: grid;
  place-items: center;

  background: var(--primary);

  color: white;

  font-size: 27px;
  font-weight: 900;
}

.sidebar-brand strong {
  display: block;

  font-size: 15px;
  letter-spacing: .7px;
}

.sidebar-brand span {
  display: block;

  margin-top: 2px;

  color: #8996aa;

  font-size: 10px;
  letter-spacing: 1.5px;
}

.admin-nav {
  flex: 1;

  overflow-y: auto;

  padding: 16px 12px;
}

.nav-item {
  width: 100%;

  border: 0;
  background: transparent;

  color: #c9d3e2;

  display: flex;
  align-items: center;

  gap: 11px;

  text-align: left;

  padding: 11px 13px;

  border-radius: 9px;

  margin-bottom: 3px;

  transition:
    background .15s ease,
    color .15s ease;
}

.nav-item span {
  width: 23px;

  text-align: center;
}

.nav-item:hover {
  background: var(--sidebar-hover);
  color: white;
}

.nav-item.active {
  background: var(--primary);
  color: white;
}

.sidebar-bottom {
  padding: 14px;

  border-top:
    1px solid rgba(255,255,255,.08);
}

.admin-mini {
  display: flex;

  align-items: center;

  gap: 10px;

  margin-bottom: 12px;
}

.admin-avatar {
  width: 36px;
  height: 36px;

  border-radius: 50%;

  background: #26364f;

  display: grid;
  place-items: center;

  font-weight: 800;
}

.admin-mini strong {
  display: block;

  font-size: 12px;
}

.admin-mini span {
  display: block;

  margin-top: 2px;

  color: #8996aa;

  font-size: 10px;
}

.logout-button {
  width: 100%;

  border: 1px solid rgba(255,255,255,.1);

  background: transparent;

  color: #c9d3e2;

  padding: 10px;

  border-radius: 8px;
}

.logout-button:hover {
  background: rgba(255,255,255,.08);
  color: white;
}


/* ==========================================================
   MAIN
   ========================================================== */

.main {
  width: calc(100% - 265px);

  margin-left: 265px;

  min-height: 100vh;
}

.topbar {
  height: 76px;

  background: white;

  border-bottom:
    1px solid var(--border);

  display: flex;

  align-items: center;

  justify-content: space-between;

  padding: 0 28px;

  position: sticky;

  top: 0;

  z-index: 50;
}

.topbar-title span {
  display: block;

  color: var(--primary);

  font-size: 10px;

  font-weight: 800;

  letter-spacing: 1.2px;
}

.topbar-title h1 {
  margin: 2px 0 0;

  font-size: 20px;
}

.topbar-actions {
  display: flex;

  align-items: center;

  gap: 12px;
}

.system-status {
  display: flex;

  align-items: center;

  gap: 7px;

  color: var(--muted);

  font-size: 12px;
}

.status-dot {
  width: 8px;
  height: 8px;

  border-radius: 50%;

  background: var(--success);
}

.icon-button {
  width: 38px;
  height: 38px;

  border: 1px solid var(--border);

  background: white;

  border-radius: 9px;

  font-size: 20px;

  color: var(--muted);
}

.icon-button:hover {
  border-color: var(--primary);

  color: var(--primary);
}

.mobile-menu {
  display: none;
}


/* ==========================================================
   CONTENT
   ========================================================== */

.content {
  padding: 30px;

  max-width: 1700px;

  margin: 0 auto;
}

.page {
  display: none;
}

.page.active {
  display: block;
}

.page-header {
  display: flex;

  justify-content: space-between;

  align-items: flex-start;

  gap: 20px;

  margin-bottom: 24px;
}

.eyebrow {
  color: var(--primary);

  font-size: 10px;

  font-weight: 900;

  letter-spacing: 1.4px;
}

.page-header h2 {
  margin: 5px 0;

  font-size: 27px;
}

.page-header p {
  margin: 0;

  color: var(--muted);
}

.last-update {
  color: var(--muted);

  font-size: 12px;
}


/* ==========================================================
   MÉTRICAS
   ========================================================== */

.metrics-grid {
  display: grid;

  grid-template-columns:
    repeat(6, minmax(0, 1fr));

  gap: 14px;

  margin-bottom: 20px;
}

.metric-card {
  background: white;

  border:
    1px solid var(--border);

  border-radius: 14px;

  padding: 18px;

  display: flex;

  gap: 13px;

  box-shadow: var(--shadow);
}

.metric-icon {
  width: 42px;
  height: 42px;

  border-radius: 11px;

  display: grid;
  place-items: center;

  font-size: 19px;

  background: #edf3fb;
}

.metric-card span {
  display: block;

  color: var(--muted);

  font-size: 11px;
}

.metric-card strong {
  display: block;

  margin-top: 3px;

  font-size: 25px;
}

.metric-card small {
  display: block;

  margin-top: 2px;

  color: var(--muted);

  font-size: 10px;
}

.metric-card.blue .metric-icon {
  background: #e9f1ff;
}

.metric-card.purple .metric-icon {
  background: #f0ebff;
}

.metric-card.orange .metric-icon {
  background: #fff2df;
}

.metric-card.green .metric-icon {
  background: #e7f7ef;
}

.metric-card.red .metric-icon {
  background: #ffebeb;
}

.metric-card.teal .metric-icon {
  background: #e5f7f6;
}


/* ==========================================================
   GRIDS
   ========================================================== */

.dashboard-grid {
  display: grid;

  grid-template-columns:
    minmax(0, 1.45fr)
    minmax(340px, .8fr);

  gap: 18px;

  margin-bottom: 18px;
}


/* ==========================================================
   PANEL
   ========================================================== */

.panel {
  background: white;

  border:
    1px solid var(--border);

  border-radius: 15px;

  box-shadow: var(--shadow);

  padding: 21px;
}

.panel-header {
  display: flex;

  align-items: center;

  justify-content: space-between;

  gap: 15px;

  margin-bottom: 17px;
}

.panel-eyebrow {
  color: var(--primary);

  font-size: 9px;

  font-weight: 900;

  letter-spacing: 1.2px;
}

.panel h3 {
  margin: 3px 0 0;

  font-size: 17px;
}

.panel-header p {
  margin: 5px 0 0;

  color: var(--muted);

  font-size: 12px;
}

.small-button {
  border:
    1px solid var(--border);

  background: white;

  color: var(--primary);

  border-radius: 8px;

  padding: 8px 11px;

  font-size: 11px;

  font-weight: 700;
}

.small-button:hover {
  background: #f2f6fc;

  border-color:
    #cbd8ea;
}


/* ==========================================================
   ATIVIDADE
   ========================================================== */

.activity-list {
  display: flex;

  flex-direction: column;
}

.activity-row {
  display: flex;

  align-items: center;

  gap: 11px;

  padding: 12px 0;

  border-bottom:
    1px solid var(--border);
}

.activity-row:last-child {
  border-bottom: 0;
}

.activity-icon {
  width: 34px;
  height: 34px;

  border-radius: 9px;

  background: #f0f4f9;

  display: grid;

  place-items: center;

  flex-shrink: 0;
}

.activity-info {
  flex: 1;
}

.activity-info strong {
  display: block;

  font-size: 12px;
}

.activity-info span {
  display: block;

  margin-top: 2px;

  color: var(--muted);

  font-size: 10px;
}

.activity-row time {
  color: var(--muted);

  font-size: 9px;
}


/* ==========================================================
   ALERTAS
   ========================================================== */

.alerts-list {
  display: flex;

  flex-direction: column;
}

.alert-row {
  display: flex;

  gap: 10px;

  padding: 12px;

  border-radius: 10px;

  margin-bottom: 8px;

  background: #f7f9fc;
}

.alert-row.high {
  background: #fff0f0;
}

.alert-row.medium {
  background: #fff7e8;
}

.alert-row.info {
  background: #edf5ff;
}

.alert-icon {
  flex-shrink: 0;
}

.alert-row strong {
  display: block;

  font-size: 12px;
}

.alert-row p {
  margin: 4px 0 0;

  color: var(--muted);

  font-size: 10px;

  line-height: 1.45;
}

.no-alert {
  display: flex;

  gap: 12px;

  align-items: center;

  padding: 18px;

  border-radius: 11px;

  background: #edf8f2;

  color: var(--success);
}

.no-alert span {
  font-size: 23px;
}

.no-alert strong {
  display: block;

  font-size: 12px;
}

.no-alert p {
  margin: 3px 0 0;

  color: var(--muted);

  font-size: 10px;
}


/* ==========================================================
   SERVIÇOS
   ========================================================== */

.service-overview,
.specialist-overview {
  display: flex;

  flex-direction: column;
}

.service-row,
.specialist-row {
  display: flex;

  align-items: center;

  gap: 11px;

  padding: 11px 0;

  border-bottom:
    1px solid var(--border);
}

.service-row:last-child,
.specialist-row:last-child {
  border-bottom: 0;
}

.service-row-icon {
  width: 35px;
  height: 35px;

  display: grid;

  place-items: center;

  background: #f0f4f9;

  border-radius: 9px;
}

.service-row-info,
.specialist-info {
  flex: 1;
}

.service-row-info strong,
.specialist-info strong {
  display: block;

  font-size: 12px;
}

.service-row-info span,
.specialist-info span {
  display: block;

  margin-top: 2px;

  color: var(--muted);

  font-size: 10px;
}

.specialist-avatar {
  width: 35px;
  height: 35px;

  border-radius: 50%;

  background: #eaf1ff;

  color: var(--primary);

  display: grid;

  place-items: center;

  font-weight: 800;

  font-size: 12px;
}


/* ==========================================================
   STATUS
   ========================================================== */

.status-badge {
  display: inline-flex;

  align-items: center;

  padding: 5px 8px;

  border-radius: 999px;

  font-size: 9px;

  font-weight: 800;
}

.status-badge.success {
  background: #e6f6ee;

  color: var(--success);
}

.status-badge.disabled {
  background: #f1f3f5;

  color: var(--muted);
}

.status-badge.neutral {
  background: #eef2f7;

  color: var(--muted);
}


/* ==========================================================
   PROTEÇÃO
   ========================================================== */

.protection-dashboard {
  margin-bottom: 20px;
}

.protection-stats {
  display: grid;

  grid-template-columns:
    repeat(4, 1fr);

  gap: 12px;
}

.protection-stats > div {
  background: #f7f9fc;

  border-radius: 10px;

  padding: 15px;
}

.protection-stats span {
  display: block;

  color: var(--muted);

  font-size: 10px;
}

.protection-stats strong {
  display: block;

  margin-top: 5px;

  font-size: 23px;
}


/* ==========================================================
   PLACEHOLDER
   ========================================================== */

.module-placeholder {
  min-height: 500px;

  background: white;

  border:
    1px solid var(--border);

  border-radius: 15px;

  box-shadow: var(--shadow);

  display: flex;

  flex-direction: column;

  justify-content: center;

  align-items: center;

  text-align: center;

  padding: 40px;
}

.module-placeholder > span {
  font-size: 50px;

  margin-bottom: 10px;
}

.module-placeholder h2 {
  margin: 5px 0;

  font-size: 25px;
}

.module-placeholder p {
  color: var(--muted);

  max-width: 500px;
}


/* ==========================================================
   ESTADOS
   ========================================================== */

.loading,
.empty-state {
  color: var(--muted);

  padding: 20px 0;

  text-align: center;

  font-size: 12px;
}


/* ==========================================================
   TOAST
   ========================================================== */

.toast {
  position: fixed;

  right: 25px;
  bottom: 25px;

  min-width: 230px;

  padding: 13px 16px;

  border-radius: 10px;

  background: #172033;

  color: white;

  box-shadow:
    0 15px 40px rgba(0,0,0,.2);

  opacity: 0;

  transform:
    translateY(15px);

  pointer-events: none;

  transition:
    opacity .2s ease,
    transform .2s ease;

  z-index: 1000;

  font-size: 12px;
}

.toast.show {
  opacity: 1;

  transform:
    translateY(0);
}

.toast.success {
  background: var(--success);
}

.toast.error {
  background: var(--danger);
}


/* ==========================================================
   RESPONSIVO
   ========================================================== */

@media (max-width: 1450px) {

  .metrics-grid {
    grid-template-columns:
      repeat(3, 1fr);
  }

}


@media (max-width: 1050px) {

  .dashboard-grid {
    grid-template-columns: 1fr;
  }

  .protection-stats {
    grid-template-columns:
      repeat(2, 1fr);
  }

}


@media (max-width: 900px) {

  .sidebar {
    transform:
      translateX(-100%);

    transition:
      transform .2s ease;
  }

  .sidebar.mobile-open {
    transform:
      translateX(0);
  }

  .main {
    width: 100%;

    margin-left: 0;
  }

  .mobile-menu {
    display: inline-flex;

    border: 0;

    background: transparent;

    font-size: 20px;

    margin-right: 8px;
  }

  .topbar {
    padding: 0 17px;
  }

  .content {
    padding: 20px;
  }

}


@media (max-width: 650px) {

  .metrics-grid {
    grid-template-columns:
      repeat(2, 1fr);
  }

  .metric-card {
    padding: 14px;
  }

  .metric-card strong {
    font-size: 21px;
  }

  .page-header {
    flex-direction: column;
  }

  .protection-stats {
    grid-template-columns: 1fr;
  }

  .system-status {
    display: none;
  }

}


@media (max-width: 450px) {

  .metrics-grid {
    grid-template-columns: 1fr;
  }

  .content {
    padding: 14px;
  }

}


/* ==========================================================
   USUÁRIOS
   ========================================================== */

.users-toolbar {
  display: flex;

  align-items: center;

  gap: 10px;

  margin-bottom: 18px;

  flex-wrap: wrap;
}

.search-box {
  min-width: 280px;

  flex: 1;

  display: flex;

  align-items: center;

  gap: 8px;

  border:
    1px solid var(--border);

  border-radius: 9px;

  background: white;

  padding: 0 11px;
}

.search-box span {
  color: var(--muted);
}

.search-box input {
  width: 100%;

  border: 0;

  outline: 0;

  background: transparent;

  padding: 10px 3px;

  color: var(--text);

  font-size: 12px;
}

.users-toolbar select {
  border:
    1px solid var(--border);

  background: white;

  color: var(--text);

  border-radius: 9px;

  padding: 10px 12px;

  outline: 0;

  font-size: 11px;
}

.users-toolbar select:focus,
.search-box:focus-within {
  border-color:
    #b8cbe6;
}


/* ==========================================================
   TABELA
   ========================================================== */

.table-wrapper {
  overflow-x: auto;
}

.data-table {
  width: 100%;

  border-collapse: collapse;

  min-width: 760px;
}

.data-table th {
  text-align: left;

  padding: 11px 10px;

  border-bottom:
    1px solid var(--border);

  color: var(--muted);

  font-size: 9px;

  text-transform: uppercase;

  letter-spacing: .6px;
}

.data-table td {
  padding: 13px 10px;

  border-bottom:
    1px solid var(--border);

  font-size: 11px;

  vertical-align: middle;
}

.data-table tbody tr:hover {
  background: #fafbfd;
}

.user-name-button {
  display: inline-flex;

  align-items: center;

  gap: 9px;

  border: 0;

  background: transparent;

  padding: 0;

  color: var(--text);

  font-weight: 700;

  font-size: 11px;
}

.user-name-button:hover {
  color: var(--primary);
}

.table-avatar {
  width: 31px;
  height: 31px;

  border-radius: 50%;

  display: grid;

  place-items: center;

  background: #eaf1ff;

  color: var(--primary);

  font-weight: 800;

  font-size: 11px;
}

.plan-badge {
  display: inline-flex;

  padding: 5px 8px;

  border-radius: 999px;

  background: #eef2f7;

  color: var(--muted);

  font-size: 9px;

  font-weight: 800;
}

.plan-badge.premium {
  background: #fff2d9;

  color: #9b6400;
}

.table-actions {
  text-align: right;
}

.table-action {
  border:
    1px solid var(--border);

  background: white;

  color: var(--primary);

  border-radius: 7px;

  padding: 6px 9px;

  font-size: 10px;

  font-weight: 700;
}

.table-action:hover {
  background: #f0f5fd;
}

.table-loading,
.table-empty,
.table-error {
  text-align: center !important;

  padding: 35px 10px !important;

  color: var(--muted);
}

.table-error {
  color: var(--danger);
}


/* ==========================================================
   DRAWER
   ========================================================== */

.drawer-backdrop {
  position: fixed;

  inset: 0;

  background:
    rgba(11, 18, 30, .45);

  z-index: 500;

  display: none;
}

.drawer-backdrop.open {
  display: block;
}

.user-drawer {
  width: min(
    570px,
    95vw
  );

  height: 100%;

  margin-left: auto;

  background: white;

  overflow-y: auto;

  box-shadow:
    -15px 0 45px
    rgba(0,0,0,.18);

  animation:
    drawerIn .18s ease;
}

@keyframes drawerIn {

  from {
    transform:
      translateX(100%);
  }

  to {
    transform:
      translateX(0);
  }

}

.drawer-header {
  position: sticky;

  top: 0;

  z-index: 2;

  background: white;

  border-bottom:
    1px solid var(--border);

  padding: 20px;

  display: flex;

  align-items: flex-start;

  justify-content: space-between;
}

.drawer-header h2 {
  margin: 4px 0 0;

  font-size: 21px;
}

.drawer-close {
  width: 34px;
  height: 34px;

  border: 1px solid var(--border);

  background: white;

  border-radius: 8px;

  color: var(--muted);

  font-size: 21px;
}

.drawer-section {
  padding: 18px 20px;

  border-bottom:
    1px solid var(--border);
}

.drawer-section h3 {
  display: flex;

  align-items: center;

  justify-content: space-between;

  margin: 0 0 12px;

  font-size: 13px;
}

.drawer-section h3 span {
  color: var(--muted);

  font-size: 10px;
}

.profile-card {
  display: flex;

  align-items: center;

  gap: 12px;
}

.profile-avatar {
  width: 48px;
  height: 48px;

  border-radius: 50%;

  background: #eaf1ff;

  color: var(--primary);

  display: grid;

  place-items: center;

  font-size: 18px;

  font-weight: 900;
}

.profile-card h3 {
  margin: 0;

  font-size: 15px;
}

.profile-card p {
  margin: 3px 0 0;

  color: var(--muted);

  font-size: 11px;
}

.detail-grid {
  display: grid;

  grid-template-columns:
    repeat(2, 1fr);

  gap: 10px;
}

.detail-grid > div {
  padding: 11px;

  background: #f7f9fc;

  border-radius: 9px;
}

.detail-grid span {
  display: block;

  color: var(--muted);

  font-size: 9px;
}

.detail-grid strong {
  display: block;

  margin-top: 4px;

  font-size: 11px;

  word-break: break-word;
}

.id-value {
  font-size: 9px !important;
}

.drawer-actions {
  display: grid;

  grid-template-columns:
    1fr 1fr;

  gap: 8px;
}

.drawer-select {
  width: 100%;

  border:
    1px solid var(--border);

  border-radius: 8px;

  padding: 9px;

  background: white;

  font-size: 11px;

  outline: 0;
}

.primary-button,
.secondary-button {
  border-radius: 8px;

  padding: 9px;

  font-size: 10px;

  font-weight: 800;
}

.primary-button {
  border: 0;

  background: var(--primary);

  color: white;
}

.secondary-button {
  border:
    1px solid var(--border);

  background: white;

  color: var(--primary);
}

.mini-list {
  display: flex;

  flex-direction: column;
}

.mini-row {
  display: flex;

  align-items: center;

  gap: 10px;

  padding: 10px 0;

  border-bottom:
    1px solid var(--border);
}

.mini-row:last-child {
  border-bottom: 0;
}

.mini-row > span {
  width: 30px;
  height: 30px;

  border-radius: 8px;

  background: #f1f4f8;

  display: grid;

  place-items: center;
}

.mini-row strong {
  display: block;

  font-size: 11px;
}

.mini-row small {
  display: block;

  margin-top: 2px;

  color: var(--muted);

  font-size: 9px;
}

.drawer-empty,
.drawer-stat,
.drawer-error {
  padding: 13px;

  background: #f7f9fc;

  border-radius: 8px;

  color: var(--muted);

  font-size: 11px;
}

.drawer-error {
  color: var(--danger);

  background: #fff0f0;
}


@media (max-width: 600px) {

  .users-toolbar {
    align-items: stretch;
  }

  .search-box {
    min-width: 100%;
  }

  .users-toolbar select,
  .users-toolbar button {
    flex: 1;
  }

  .detail-grid {
    grid-template-columns: 1fr;
  }

  .drawer-actions {
    grid-template-columns: 1fr;
  }

}


/* RESGATA+ REAL SERVICES ADMIN UI */

.services-page-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20px;
  margin-bottom: 20px;
}

.services-page-header p {
  margin-top: 6px;
}

.services-toolbar {
  display: grid;
  grid-template-columns: minmax(220px, 1fr) 180px 190px auto;
  gap: 10px;
  margin-bottom: 18px;
}

.admin-input {
  width: 100%;
  box-sizing: border-box;
  border: 1px solid var(--border, #dfe3e8);
  border-radius: 10px;
  padding: 11px 12px;
  background: var(--card, #fff);
  color: inherit;
  font: inherit;
}

.admin-input:focus {
  outline: none;
  border-color: var(--primary, #2563eb);
  box-shadow: 0 0 0 3px rgba(37, 99, 235, .10);
}

.primary-button,
.secondary-button {
  border: 0;
  border-radius: 10px;
  padding: 10px 14px;
  font: inherit;
  font-weight: 600;
  cursor: pointer;
  white-space: nowrap;
}

.primary-button {
  background: var(--primary, #2563eb);
  color: #fff;
}

.secondary-button {
  background: var(--card, #fff);
  color: inherit;
  border: 1px solid var(--border, #dfe3e8);
}

.primary-button:hover,
.secondary-button:hover {
  opacity: .9;
}

.primary-button:disabled,
.secondary-button:disabled {
  opacity: .55;
  cursor: not-allowed;
}

.services-metrics {
  display: grid;
  grid-template-columns: repeat(5, minmax(0, 1fr));
  gap: 12px;
  margin-bottom: 18px;
}

.service-metric-card {
  background: var(--card, #fff);
  border: 1px solid var(--border, #e5e7eb);
  border-radius: 14px;
  padding: 16px;
}

.service-metric-card span {
  display: block;
  font-size: 12px;
  opacity: .7;
  margin-bottom: 7px;
}

.service-metric-card strong {
  font-size: 24px;
}

.services-card {
  background: var(--card, #fff);
  border: 1px solid var(--border, #e5e7eb);
  border-radius: 16px;
  overflow: hidden;
}

.services-card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 15px;
  padding: 16px 18px;
  border-bottom: 1px solid var(--border, #e5e7eb);
}

.services-card-header strong {
  display: block;
}

.services-card-header span {
  font-size: 12px;
  opacity: .65;
}

.service-loading {
  font-size: 12px !important;
}

.services-admin-list {
  display: flex;
  flex-direction: column;
}

.service-admin-row {
  display: grid;
  grid-template-columns: minmax(0, 1fr) auto auto;
  align-items: center;
  gap: 18px;
  padding: 17px 18px;
  border-bottom: 1px solid var(--border, #eef0f2);
}

.service-admin-row:last-child {
  border-bottom: 0;
}

.service-admin-main {
  display: flex;
  align-items: flex-start;
  gap: 13px;
  min-width: 0;
}

.service-admin-icon {
  width: 42px;
  height: 42px;
  flex: 0 0 42px;
  display: grid;
  place-items: center;
  border-radius: 12px;
  background: rgba(37, 99, 235, .08);
}

.service-admin-info {
  min-width: 0;
}

.service-admin-info strong,
.service-admin-info span,
.service-admin-info small {
  display: block;
}

.service-admin-info strong {
  margin-bottom: 4px;
}

.service-admin-info span {
  font-size: 13px;
  opacity: .78;
  line-height: 1.45;
}

.service-admin-info small {
  margin-top: 5px;
  font-size: 11px;
  opacity: .55;
}

.service-admin-status {
  display: flex;
  flex-direction: column;
  gap: 5px;
  font-size: 12px;
  white-space: nowrap;
}

.service-status-on {
  color: #15803d;
}

.service-status-off {
  color: #b91c1c;
}

.service-status-visible {
  color: #2563eb;
}

.service-status-hidden {
  color: #6b7280;
}

.service-admin-actions {
  display: flex;
  flex-wrap: wrap;
  justify-content: flex-end;
  gap: 7px;
}

.service-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 7px;
  min-height: 170px;
  padding: 25px;
  text-align: center;
  opacity: .75;
}

.service-error {
  opacity: 1;
}

.service-error strong {
  color: #b91c1c;
}

.service-modal[hidden] {
  display: none;
}

.service-modal {
  position: fixed;
  inset: 0;
  z-index: 9999;
}

.service-modal-backdrop {
  position: absolute;
  inset: 0;
  background: rgba(15, 23, 42, .55);
}

.service-modal-panel {
  position: relative;
  z-index: 1;
  width: min(560px, calc(100% - 28px));
  max-height: calc(100vh - 28px);
  overflow: auto;
  margin: 14px auto;
  padding: 22px;
  border-radius: 18px;
  background: var(--card, #fff);
  box-shadow: 0 24px 70px rgba(0, 0, 0, .22);
}

.service-modal-header {
  display: flex;
  justify-content: space-between;
  gap: 15px;
  margin-bottom: 20px;
}

.service-modal-header h3 {
  margin: 4px 0 0;
}

.service-modal-close {
  width: 36px;
  height: 36px;
  border: 0;
  border-radius: 10px;
  background: transparent;
  font-size: 25px;
  cursor: pointer;
}

.service-form-field {
  display: block;
  margin-bottom: 15px;
}

.service-form-field > span {
  display: block;
  margin-bottom: 6px;
  font-size: 13px;
  font-weight: 600;
}

.service-form-checks {
  display: flex;
  flex-wrap: wrap;
  gap: 16px;
  margin: 8px 0 18px;
  font-size: 13px;
}

.service-form-checks label {
  display: flex;
  align-items: center;
  gap: 7px;
}

.service-form-error {
  margin-bottom: 15px;
  padding: 10px 12px;
  border-radius: 10px;
  background: rgba(185, 28, 28, .08);
  color: #b91c1c;
  font-size: 13px;
}

.service-modal-actions {
  display: flex;
  justify-content: flex-end;
  gap: 9px;
  padding-top: 5px;
}

body.service-modal-open {
  overflow: hidden;
}

@media (max-width: 1050px) {
  .services-toolbar {
    grid-template-columns: 1fr 1fr;
  }

  .services-metrics {
    grid-template-columns: repeat(3, 1fr);
  }

  .service-admin-row {
    grid-template-columns: 1fr;
  }

  .service-admin-status {
    flex-direction: row;
    flex-wrap: wrap;
  }

  .service-admin-actions {
    justify-content: flex-start;
  }
}

@media (max-width: 650px) {
  .services-page-header {
    flex-direction: column;
  }

  .services-toolbar {
    grid-template-columns: 1fr;
  }

  .services-metrics {
    grid-template-columns: repeat(2, 1fr);
  }

  .services-card-header {
    align-items: flex-start;
    flex-direction: column;
  }

  .service-admin-actions {
    display: grid;
    grid-template-columns: 1fr;
  }

  .service-admin-actions button {
    width: 100%;
  }
}


/* RESGATA+ REAL REQUESTS ADMIN UI */

.requests-page-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20px;
  margin-bottom: 20px;
}

.requests-toolbar {
  display: grid;
  grid-template-columns:
    minmax(220px, 1fr)
    210px
    210px;
  gap: 10px;
  margin-bottom: 18px;
}

.requests-metrics {
  display: grid;
  grid-template-columns:
    repeat(5, minmax(0, 1fr));
  gap: 12px;
  margin-bottom: 18px;
}

.request-metric-card {
  background: var(--card, #fff);
  border: 1px solid var(--border, #e5e7eb);
  border-radius: 14px;
  padding: 16px;
}

.request-metric-card span {
  display: block;
  font-size: 12px;
  opacity: .7;
  margin-bottom: 7px;
}

.request-metric-card strong {
  font-size: 24px;
}

.requests-card {
  background: var(--card, #fff);
  border: 1px solid var(--border, #e5e7eb);
  border-radius: 16px;
  overflow: hidden;
}

.requests-card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 15px;
  padding: 16px 18px;
  border-bottom: 1px solid var(--border, #e5e7eb);
}

.requests-card-header strong,
.requests-card-header span {
  display: block;
}

.requests-card-header span {
  font-size: 12px;
  opacity: .65;
}

.requests-admin-list {
  display: flex;
  flex-direction: column;
}

.request-admin-row {
  display: grid;
  grid-template-columns:
    minmax(0, 1fr)
    auto
    auto;
  align-items: center;
  gap: 18px;
  padding: 17px 18px;
  border-bottom: 1px solid var(--border, #eef0f2);
}

.request-admin-row:last-child {
  border-bottom: 0;
}

.request-admin-main {
  display: flex;
  align-items: flex-start;
  gap: 13px;
  min-width: 0;
}

.request-admin-icon {
  width: 42px;
  height: 42px;
  flex: 0 0 42px;
  display: grid;
  place-items: center;
  border-radius: 12px;
  background: rgba(37, 99, 235, .08);
}

.request-admin-info {
  min-width: 0;
}

.request-admin-info strong,
.request-admin-info span,
.request-admin-info small {
  display: block;
}

.request-admin-info strong {
  margin-bottom: 4px;
}

.request-admin-info span {
  font-size: 13px;
  opacity: .78;
}

.request-admin-info small {
  margin-top: 5px;
  font-size: 11px;
  opacity: .55;
  overflow-wrap: anywhere;
}

.request-admin-status {
  display: flex;
  flex-direction: column;
  gap: 5px;
  white-space: nowrap;
}

.request-admin-status small {
  font-size: 11px;
  opacity: .6;
}

.request-status-pending {
  color: #a16207;
}

.request-status-received {
  color: #7c3aed;
}

.request-status-in_progress {
  color: #2563eb;
}

.request-status-waiting_user,
.request-status-waiting_specialist {
  color: #c2410c;
}

.request-status-resolved {
  color: #15803d;
}

.request-status-cancelled {
  color: #6b7280;
}

.request-status-rejected {
  color: #b91c1c;
}

.request-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 7px;
  min-height: 170px;
  padding: 25px;
  text-align: center;
  opacity: .75;
}

.request-error {
  opacity: 1;
}

.request-error strong {
  color: #b91c1c;
}

.request-modal[hidden] {
  display: none;
}

.request-modal {
  position: fixed;
  inset: 0;
  z-index: 9999;
}

.request-modal-backdrop {
  position: absolute;
  inset: 0;
  background: rgba(15, 23, 42, .55);
}

.request-modal-panel {
  position: relative;
  z-index: 1;
  width: min(760px, calc(100% - 28px));
  max-height: calc(100vh - 28px);
  overflow: auto;
  margin: 14px auto;
  padding: 22px;
  border-radius: 18px;
  background: var(--card, #fff);
  box-shadow: 0 24px 70px rgba(0, 0, 0, .22);
}

.request-modal-header {
  display: flex;
  justify-content: space-between;
  gap: 15px;
  margin-bottom: 20px;
}

.request-modal-header h3 {
  margin: 4px 0 0;
}

.request-modal-close {
  width: 36px;
  height: 36px;
  border: 0;
  border-radius: 10px;
  background: transparent;
  font-size: 25px;
  cursor: pointer;
}

.request-detail-grid {
  display: grid;
  grid-template-columns:
    repeat(2, minmax(0, 1fr));
  gap: 12px;
}

.request-detail-grid > div {
  padding: 13px;
  border: 1px solid var(--border, #e5e7eb);
  border-radius: 12px;
}

.request-detail-grid span,
.request-detail-grid strong {
  display: block;
}

.request-detail-grid span {
  font-size: 11px;
  opacity: .6;
  margin-bottom: 5px;
}

.request-detail-grid strong {
  font-size: 13px;
  overflow-wrap: anywhere;
}

.request-details-content {
  margin-top: 16px;
}

.request-details-content > strong {
  display: block;
  margin-bottom: 8px;
}

.request-details-content pre {
  margin: 0;
  padding: 14px;
  border-radius: 12px;
  background: rgba(15, 23, 42, .05);
  overflow: auto;
  white-space: pre-wrap;
  overflow-wrap: anywhere;
  font-size: 12px;
  line-height: 1.5;
}

.request-status-box {
  display: flex;
  align-items: flex-end;
  gap: 12px;
  margin-top: 18px;
  padding-top: 18px;
  border-top: 1px solid var(--border, #e5e7eb);
}

.request-status-box label {
  flex: 1;
}

.request-status-box label > span {
  display: block;
  margin-bottom: 6px;
  font-size: 13px;
  font-weight: 600;
}

.request-form-error {
  margin-top: 14px;
  padding: 10px 12px;
  border-radius: 10px;
  background: rgba(185, 28, 28, .08);
  color: #b91c1c;
  font-size: 13px;
}

body.request-modal-open {
  overflow: hidden;
}

@media (max-width: 1050px) {

  .requests-toolbar {
    grid-template-columns: 1fr 1fr;
  }

  .requests-metrics {
    grid-template-columns:
      repeat(3, 1fr);
  }

  .request-admin-row {
    grid-template-columns: 1fr;
  }

  .request-admin-status {
    flex-direction: row;
    flex-wrap: wrap;
  }

}

@media (max-width: 650px) {

  .requests-page-header {
    flex-direction: column;
  }

  .requests-toolbar {
    grid-template-columns: 1fr;
  }

  .requests-metrics {
    grid-template-columns:
      repeat(2, 1fr);
  }

  .requests-card-header {
    align-items: flex-start;
    flex-direction: column;
  }

  .request-detail-grid {
    grid-template-columns: 1fr;
  }

  .request-status-box {
    align-items: stretch;
    flex-direction: column;
  }

  .request-status-box button {
    width: 100%;
  }

}


/* ============================================================
   RELATÓRIOS ADMINISTRATIVOS
   ============================================================ */

.reports-page {
  width: 100%;
}

.reports-page .page-header {
  margin-bottom: 24px;
}

.reports-page .page-header h1 {
  margin: 4px 0 8px;
}

.reports-page .page-header p {
  margin: 0;
  max-width: 760px;
}

.reports-page .eyebrow {
  display: inline-block;
  font-size: 11px;
  font-weight: 700;
  letter-spacing: 0.08em;
  opacity: 0.7;
}

.reports-toolbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20px;
  flex-wrap: wrap;
  margin-bottom: 28px;
  padding: 16px;
  border: 1px solid var(--border-color, rgba(128, 128, 128, 0.2));
  border-radius: 14px;
  background: var(--card-bg, rgba(255, 255, 255, 0.03));
}

.reports-period {
  display: flex;
  align-items: center;
  gap: 14px;
  flex-wrap: wrap;
}

.reports-period > span {
  font-size: 13px;
  font-weight: 700;
}

.reports-period-buttons {
  display: flex;
  gap: 8px;
  flex-wrap: wrap;
}

.reports-period-btn {
  appearance: none;
  border: 1px solid var(--border-color, rgba(128, 128, 128, 0.25));
  background: transparent;
  color: inherit;
  border-radius: 9px;
  padding: 8px 13px;
  cursor: pointer;
  font-size: 13px;
  font-weight: 600;
  transition:
    background 0.18s ease,
    border-color 0.18s ease,
    transform 0.18s ease;
}

.reports-period-btn:hover {
  transform: translateY(-1px);
}

.reports-period-btn.active {
  background: var(--primary-color, #2563eb);
  border-color: var(--primary-color, #2563eb);
  color: #fff;
}

.reports-status {
  font-size: 12px;
  opacity: 0.7;
}

.reports-message {
  margin-bottom: 20px;
  padding: 14px 16px;
  border-radius: 10px;
  font-size: 13px;
}

.reports-message.error {
  border: 1px solid rgba(220, 38, 38, 0.35);
  background: rgba(220, 38, 38, 0.08);
}

.reports-message:not(.error) {
  border: 1px solid var(--border-color, rgba(128, 128, 128, 0.2));
  background: var(--card-bg, rgba(255, 255, 255, 0.03));
}

.reports-page .hidden {
  display: none !important;
}

.reports-group {
  margin-bottom: 32px;
}

.reports-group-header {
  margin-bottom: 14px;
}

.reports-group-header h2 {
  margin: 0 0 5px;
  font-size: 18px;
}

.reports-group-header p {
  margin: 0;
  font-size: 13px;
  opacity: 0.68;
}

.reports-grid {
  display: grid;
  grid-template-columns: repeat(6, minmax(0, 1fr));
  gap: 14px;
}

.reports-grid-small {
  grid-template-columns: repeat(5, minmax(0, 1fr));
}

.report-card {
  min-width: 0;
  padding: 18px;
  border: 1px solid var(--border-color, rgba(128, 128, 128, 0.2));
  border-radius: 14px;
  background: var(--card-bg, rgba(255, 255, 255, 0.03));
  display: flex;
  flex-direction: column;
  gap: 8px;
}

.report-card-icon {
  font-size: 22px;
  line-height: 1;
}

.report-card-label {
  font-size: 12px;
  opacity: 0.68;
}

.report-card strong {
  font-size: 23px;
  line-height: 1.2;
  word-break: break-word;
}

.reports-detail-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 14px;
}

.report-panel {
  min-width: 0;
  padding: 18px;
  border: 1px solid var(--border-color, rgba(128, 128, 128, 0.2));
  border-radius: 14px;
  background: var(--card-bg, rgba(255, 255, 255, 0.03));
}

.report-panel h3 {
  margin: 0 0 14px;
  font-size: 15px;
}

.report-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
  padding: 10px 0;
  border-bottom: 1px solid var(--border-color, rgba(128, 128, 128, 0.12));
}

.report-row:first-of-type {
  padding-top: 0;
}

.report-row:last-of-type {
  border-bottom: 0;
  padding-bottom: 0;
}

.report-row span {
  font-size: 13px;
  opacity: 0.72;
}

.report-row strong {
  font-size: 14px;
  text-align: right;
  word-break: break-word;
}

.reports-footer {
  padding: 18px 0 8px;
  font-size: 12px;
  opacity: 0.58;
}


/* ============================================================
   RESPONSIVIDADE
   ============================================================ */

@media (max-width: 1200px) {

  .reports-grid {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .reports-grid-small {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .reports-detail-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

}

@media (max-width: 760px) {

  .reports-toolbar {
    align-items: flex-start;
    flex-direction: column;
  }

  .reports-period {
    align-items: flex-start;
    flex-direction: column;
  }

  .reports-grid,
  .reports-grid-small,
  .reports-detail-grid {
    grid-template-columns: 1fr;
  }

  .reports-period-buttons {
    width: 100%;
  }

  .reports-period-btn {
    flex: 1;
  }

}
