:root {
  --bg: #f4f7fb;
  --panel: #ffffff;
  --sidebar: #101827;
  --sidebar-hover: #1d293b;
  --text: #172033;
  --muted: #687386;
  --border: #e5e9f0;
  --primary: #1769e0;
  --primary-dark: #0e4fae;
  --success: #16845b;
  --warning: #b7791f;
  --danger: #c0392b;
  --shadow: 0 8px 30px rgba(18, 38, 63, .07);
}

* {
  box-sizing: border-box;
}

body {
  margin: 0;
  font-family: Inter, Arial, sans-serif;
  background: var(--bg);
  color: var(--text);
}

button {
  font: inherit;
}

.app {
  min-height: 100vh;
  display: flex;
}

.sidebar {
  width: 260px;
  background: var(--sidebar);
  color: white;
  min-height: 100vh;
  padding: 20px 14px;
  display: flex;
  flex-direction: column;
  position: fixed;
  left: 0;
  top: 0;
  bottom: 0;
}

.brand {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 4px 10px 24px;
}

.brand-icon {
  width: 42px;
  height: 42px;
  border-radius: 12px;
  background: var(--primary);
  display: grid;
  place-items: center;
  font-size: 28px;
  font-weight: 800;
}

.brand strong {
  display: block;
  letter-spacing: .8px;
}

.brand span {
  color: #93a4bd;
  font-size: 11px;
  letter-spacing: 2px;
}

nav {
  display: flex;
  flex-direction: column;
  gap: 4px;
  overflow-y: auto;
}

.nav-item {
  border: 0;
  background: transparent;
  color: #b8c3d4;
  padding: 12px 13px;
  border-radius: 10px;
  text-align: left;
  cursor: pointer;
  display: flex;
  align-items: center;
  gap: 11px;
}

.nav-item:hover,
.nav-item.active {
  background: var(--sidebar-hover);
  color: white;
}

.nav-item.active {
  box-shadow: inset 3px 0 var(--primary);
}

.sidebar-bottom {
  margin-top: auto;
  padding-top: 15px;
  border-top: 1px solid rgba(255,255,255,.08);
}

.admin-mini {
  display: flex;
  gap: 10px;
  align-items: center;
  margin-bottom: 12px;
}

.avatar {
  width: 36px;
  height: 36px;
  border-radius: 50%;
  background: #26364e;
  display: grid;
  place-items: center;
}

.admin-mini strong,
.admin-mini small {
  display: block;
}

.admin-mini small {
  color: #8795aa;
  margin-top: 3px;
}

.logout {
  width: 100%;
  padding: 10px;
  border: 1px solid rgba(255,255,255,.1);
  background: transparent;
  color: #cbd5e1;
  border-radius: 9px;
  cursor: pointer;
}

.logout:hover {
  background: #263246;
}

.main {
  margin-left: 260px;
  width: calc(100% - 260px);
}

.topbar {
  min-height: 86px;
  background: white;
  border-bottom: 1px solid var(--border);
  padding: 18px 30px;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.topbar h1 {
  margin: 0;
  font-size: 25px;
}

.topbar p {
  margin: 5px 0 0;
  color: var(--muted);
}

.top-actions {
  display: flex;
  align-items: center;
  gap: 8px;
  color: var(--muted);
  font-size: 14px;
}

.status-dot {
  width: 9px;
  height: 9px;
  border-radius: 50%;
  background: var(--success);
}

.icon-button {
  border: 1px solid var(--border);
  background: white;
  width: 38px;
  height: 38px;
  border-radius: 9px;
  cursor: pointer;
  margin-left: 10px;
}

.content {
  padding: 28px 30px 45px;
  max-width: 1500px;
}

.mobile-brand {
  display: none;
}

.cards {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 17px;
  margin-bottom: 22px;
}

.card {
  background: var(--panel);
  border: 1px solid var(--border);
  border-radius: 14px;
  padding: 20px;
  box-shadow: var(--shadow);
}

.metric {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
}

.metric-icon {
  width: 42px;
  height: 42px;
  display: grid;
  place-items: center;
  border-radius: 11px;
  background: #edf4ff;
  font-size: 20px;
}

.metric-label {
  color: var(--muted);
  font-size: 13px;
}

.metric-value {
  display: block;
  font-size: 29px;
  margin-top: 6px;
}

.grid-2 {
  display: grid;
  grid-template-columns: 1.5fr 1fr;
  gap: 20px;
}

.panel {
  background: white;
  border: 1px solid var(--border);
  border-radius: 14px;
  box-shadow: var(--shadow);
  overflow: hidden;
}

.panel-head {
  padding: 18px 20px;
  border-bottom: 1px solid var(--border);
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.panel-head h2 {
  margin: 0;
  font-size: 17px;
}

.panel-body {
  padding: 20px;
}

.table-wrap {
  overflow-x: auto;
}

table {
  width: 100%;
  border-collapse: collapse;
}

th,
td {
  padding: 13px 15px;
  border-bottom: 1px solid var(--border);
  text-align: left;
  font-size: 14px;
}

th {
  color: var(--muted);
  font-size: 12px;
  text-transform: uppercase;
  letter-spacing: .5px;
}

.badge {
  display: inline-flex;
  padding: 5px 9px;
  border-radius: 20px;
  font-size: 12px;
  background: #edf1f6;
}

.badge.success {
  color: var(--success);
  background: #e9f8f1;
}

.badge.warning {
  color: var(--warning);
  background: #fff5df;
}

.badge.danger {
  color: var(--danger);
  background: #ffebe8;
}

.section-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 18px;
}

.empty {
  text-align: center;
  padding: 40px 20px;
  color: var(--muted);
}

.module-header {
  margin-bottom: 20px;
}

.module-header h2 {
  margin: 0 0 6px;
}

.module-header p {
  margin: 0;
  color: var(--muted);
}

.btn {
  border: 0;
  border-radius: 9px;
  padding: 9px 14px;
  cursor: pointer;
}

.btn-primary {
  background: var(--primary);
  color: white;
}

.btn-primary:hover {
  background: var(--primary-dark);
}

.quick-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
}

.quick-actions .btn {
  background: #f0f5fc;
  color: #1e3a5f;
}

.log-item {
  padding: 12px 0;
  border-bottom: 1px solid var(--border);
}

.log-item:last-child {
  border-bottom: 0;
}

.log-item strong {
  display: block;
  font-size: 13px;
}

.log-item small {
  color: var(--muted);
}

.notice {
  padding: 14px;
  border-radius: 10px;
  background: #f5f8fc;
  color: var(--muted);
  line-height: 1.5;
}

.toast {
  position: fixed;
  right: 25px;
  bottom: 25px;
  background: #172033;
  color: white;
  padding: 13px 17px;
  border-radius: 9px;
  display: none;
  z-index: 100;
}

@media (max-width: 1100px) {
  .cards {
    grid-template-columns: repeat(2, 1fr);
  }

  .grid-2 {
    grid-template-columns: 1fr;
  }

  .section-grid {
    grid-template-columns: repeat(2, 1fr);
  }
}

@media (max-width: 760px) {
  .sidebar {
    width: 72px;
    padding: 12px 8px;
  }

  .brand {
    justify-content: center;
    padding: 4px 0 18px;
  }

  .brand > div:last-child,
  .nav-item span,
  .admin-mini > div:last-child,
  .logout {
    display: none;
  }

  .nav-item {
    justify-content: center;
    padding: 13px 8px;
    font-size: 18px;
  }

  .main {
    margin-left: 72px;
    width: calc(100% - 72px);
  }

  .topbar {
    padding: 16px;
  }

  .content {
    padding: 18px 14px;
  }

  .top-actions span:not(.status-dot) {
    display: none;
  }

  .cards,
  .section-grid {
    grid-template-columns: 1fr;
  }
}
