router.patch("/:id/details", (req, res) => {
  const ticket = db.prepare(`
    SELECT *
    FROM tickets
    WHERE id = ?
  `).get(req.params.id);

  if (!ticket) {
    return res.status(404).json({
      ok: false,
      error: "TICKET_NOT_FOUND"
    });
  }

  const details = req.body?.details ?? {};

  db.prepare(`
    UPDATE tickets
    SET
      details = ?,
      updated_at = CURRENT_TIMESTAMP
    WHERE id = ?
  `).run(
    JSON.stringify(details),
    req.params.id
  );

  audit(
    req.admin.id,
    "admin.ticket.details_updated",
    req.params.id,
    {
      previousLength: String(ticket.details || "").length,
      newLength: JSON.stringify(details).length
    }
  );

  res.json({
    ok: true,
    ticket: db.prepare(`
      SELECT *
      FROM tickets
      WHERE id = ?
    `).get(req.params.id)
  });
});

export default router;
