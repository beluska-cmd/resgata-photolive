async summary() {

try {

const response =
await this.api(
"/api/admin/tickets/summary"
);

const data =
await response.json();

if (!data.ok) {
throw new Error(
data.error || "Erro no resumo"
);
}

const summary =
data.summary || {};

const byStatus =
summary.byStatus || [];

const byPriority =
summary.byPriority || [];


document.getElementById(
"tickets-summary"
).innerHTML = `

<div class="dashboard-grid">

<div class="admin-card">

<div>🎧 Total</div>

<strong>
${Number(summary.total || 0)}
</strong>

</div>


<div class="admin-card">

<div>📋 Status</div>

<strong>
${byStatus.length}
</strong>

</div>


<div class="admin-card">

<div>⚠️ Prioridades</div>

<strong>
${byPriority.length}
</strong>

</div>

</div>

`;

} catch (error) {

console.error(
"ERRO RESUMO TICKETS:",
error
);

const box =
document.getElementById(
"tickets-summary"
);

if (box) {

box.innerHTML =
"<p>Não foi possível carregar o resumo.</p>";

}

}

},



async list() {

const search =
document.getElementById(
"ticket-search"
)?.value || "";


const status =
document.getElementById(
"ticket-status"
)?.value || "";


const priority =
document.getElementById(
"ticket-priority"
)?.value || "";


const params =
new URLSearchParams();

if (search)
params.set("search", search);

if (status)
params.set("status", status);

if (priority)
params.set("priority", priority);


try {

const response =
await this.api(
"/api/admin/tickets?" +
params.toString()
);

const data =
await response.json();

if (!data.ok) {
throw new Error(
data.error || "Erro ao carregar tickets"
);
}


const tickets =
data.tickets || [];


const box =
document.getElementById(
"tickets-list"
);


if (!box) return;


if (!tickets.length) {

box.innerHTML = `

<div class="empty-state">

<strong>
Nenhum atendimento encontrado.
</strong>

<p>
Não existem tickets correspondentes aos filtros atuais.
</p>

</div>

`;

return;

}


box.innerHTML =
tickets.map(ticket => `

<div class="admin-card">

<h3>
🎧 #${this.escape(ticket.id)}
—
${this.escape(
ticket.subject || "Sem assunto"
)}
</h3>


<p>
👤
<strong>
${this.escape(
ticket.user_name || "Usuário não identificado"
)}
</strong>
</p>


<p>
✉️
${this.escape(
ticket.user_email || "-"
)}
</p>


<p>
Status:
<strong>
${this.escape(
ticket.status || "-"
)}
</strong>
</p>


<p>
Prioridade:
<strong>
${this.escape(
ticket.priority || "normal"
)}
</strong>
</p>


<p>
${this.formatDate(
ticket.created_at
)}
</p>


<button
type="button"
onclick="
ResgataTickets.detail('${this.escapeJs(ticket.id)}')
"
>
Abrir atendimento
</button>

</div>

`).join("");


} catch (error) {

console.error(
"ERRO LISTA TICKETS:",
error
);


const box =
document.getElementById(
"tickets-list"
);

if (box) {

box.innerHTML = `

<div class="empty-state">

<strong>
Erro ao carregar atendimentos.
</strong>

<p>
Verifique a conexão com a API.
</p>

</div>

`;

}

}

},



