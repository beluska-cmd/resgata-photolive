window.ResgataTickets = {

async api(url, options = {}) {

return fetch(url, {
  ...options,
  headers: {
    "Content-Type": "application/json",
    Authorization:
      "Bearer " +
      (localStorage.getItem("resgata_admin_token") || "")
  }
});

},


